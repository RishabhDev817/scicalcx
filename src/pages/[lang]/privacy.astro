---
import PrivacyView from '../../components/pages/PrivacyView.astro';
import { supportedLanguages, type SupportedLanguage } from '../../i18n/ui';

export function getStaticPaths() {
  return supportedLanguages.filter((l) => l !== 'en').map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params as { lang: SupportedLanguage };
---

<PrivacyView lang={lang} />
