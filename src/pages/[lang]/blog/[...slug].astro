---
import BlogPostView from '../../../components/pages/BlogPostView.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import type { SupportedLanguage } from '../../../i18n/ui';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog');
  // Only generate paths for posts that genuinely exist in this language
  const localizedPosts = allPosts.filter((p) => p.id.includes('/'));

  return localizedPosts.map((post) => {
    const [lang, ...slugParts] = post.id.split('/');
    const slug = slugParts.join('/');
    return {
      params: { lang, slug },
      props: { post, lang: lang as SupportedLanguage },
    };
  });
}

interface Props {
  post: CollectionEntry<'blog'>;
  lang: SupportedLanguage;
}

const { post, lang } = Astro.props;
---

<BlogPostView post={post} lang={lang} />
