---
import BlogPostView from '../../../components/pages/BlogPostView.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { supportedLanguages, type SupportedLanguage } from '../../../i18n/ui';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog');
  // Only generate paths for posts that genuinely exist in our active supported languages
  const localizedPosts = allPosts.filter((p) => {
    if (!p.id.includes('/')) return false;
    const lang = p.id.split('/')[0];
    return supportedLanguages.includes(lang as SupportedLanguage);
  });

  return localizedPosts.map((post) => {
    const [lang, ...slugParts] = post.id.split('/');
    const slug = slugParts.join('/');
    return {
      params: { lang, slug },
      props: { post, lang: lang as SupportedLanguage },
    };
  });
}

interface Props {
  post: CollectionEntry<'blog'>;
  lang: SupportedLanguage;
}

const { post, lang } = Astro.props;
---

<BlogPostView post={post} lang={lang} />
