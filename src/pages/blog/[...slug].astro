---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

function formatDate(date: Date) {
  return new Intl.DateTimeFormat('en-US', {
    month: 'long',
    day: 'numeric',
    year: 'numeric',
  }).format(new Date(date));
}
---

<Layout
  activeTab="blog"
  title={`${post.data.title} | SciCalcX Engineering`}
  description={post.data.description}
>
  <article class="w-full max-w-3xl mx-auto space-y-8 font-sans pb-12">
    <!-- Breadcrumbs -->
    <nav class="flex items-center space-x-2 text-xs font-mono text-brand-text-dim border-b border-brand-border/40 pb-3">
      <a href="/" class="hover:text-brand-blue-neon transition-colors">Home</a>
      <span>/</span>
      <a href="/blog" class="hover:text-brand-blue-neon transition-colors">Blog</a>
      <span>/</span>
      <span class="text-brand-text-muted truncate max-w-[200px] sm:max-w-xs">{post.data.title}</span>
    </nav>

    <!-- Post Header -->
    <header class="space-y-3">
      <div class="flex flex-wrap items-center gap-3 text-xs font-mono text-brand-text-muted">
        <time datetime={post.data.pubDate.toISOString()} class="text-brand-blue-neon font-semibold">
          {formatDate(post.data.pubDate)}
        </time>
        <span>&bull;</span>
        <span>By {post.data.author}</span>
        <span>&bull;</span>
        <span class="text-emerald-400">Technical Tutorial</span>
      </div>

      <h1 class="text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight text-white leading-tight">
        {post.data.title}
      </h1>

      <p class="text-sm sm:text-base text-brand-text-muted leading-relaxed font-sans pt-1 border-l-2 border-brand-blue pl-4 italic">
        {post.data.description}
      </p>
    </header>

    <!-- Post Body Content -->
    <div class="blog-prose border border-brand-border bg-brand-gray-dark/40 rounded-xl p-6 sm:p-10 shadow-xl backdrop-blur-sm text-brand-text leading-relaxed text-sm sm:text-base space-y-6">
      <Content />
    </div>

    <!-- Post Footer Navigation -->
    <div class="border-t border-brand-border/60 pt-6 flex flex-col sm:flex-row items-center justify-between gap-4 font-mono text-xs">
      <a
        href="/blog"
        class="inline-flex items-center gap-1.5 text-brand-blue-neon hover:text-white transition-colors"
      >
        &larr; Back to all articles
      </a>
      <a
        href="/compiler"
        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded border border-brand-border bg-brand-black hover:border-brand-border-strong text-white transition-colors"
      >
        Open Code Sandbox &rarr;
      </a>
    </div>
  </article>

  <style is:global>
    /* Styling for rendered Markdown within .blog-prose */
    .blog-prose h1,
    .blog-prose h2,
    .blog-prose h3,
    .blog-prose h4 {
      color: #ffffff;
      font-weight: 700;
      letter-spacing: -0.02em;
      margin-top: 1.75rem;
      margin-bottom: 0.75rem;
    }
    .light .blog-prose h1,
    .light .blog-prose h2,
    .light .blog-prose h3,
    .light .blog-prose h4 {
      color: #111827;
    }
    .blog-prose h1 { font-size: 1.65rem; }
    .blog-prose h2 { font-size: 1.35rem; border-bottom: 1px solid rgba(255,255,255,0.08); padding-bottom: 0.5rem; }
    .light .blog-prose h2 { border-bottom-color: rgba(0,0,0,0.08); }
    .blog-prose h3 { font-size: 1.15rem; }
    
    .blog-prose p {
      color: #a1a1aa;
      line-height: 1.75;
      margin-bottom: 1rem;
    }
    .light .blog-prose p {
      color: #374151;
    }

    .blog-prose strong {
      color: #f4f4f5;
      font-weight: 600;
    }
    .light .blog-prose strong {
      color: #111827;
    }

    .blog-prose ul, .blog-prose ol {
      margin-left: 1.5rem;
      margin-bottom: 1.25rem;
      color: #a1a1aa;
      line-height: 1.7;
    }
    .light .blog-prose ul, .light .blog-prose ol {
      color: #374151;
    }
    .blog-prose ul { list-style-type: disc; }
    .blog-prose ol { list-style-type: decimal; }
    .blog-prose li { margin-bottom: 0.35rem; }

    .blog-prose a {
      color: #00a2ff;
      text-decoration: underline;
      text-underline-offset: 3px;
      transition: color 0.15s;
    }
    .blog-prose a:hover {
      color: #ffffff;
    }
    .light .blog-prose a:hover {
      color: #0051b3;
    }

    .blog-prose blockquote {
      border-left: 3px solid #0070f3;
      padding-left: 1rem;
      font-style: italic;
      color: #71717a;
      margin: 1.5rem 0;
    }

    .blog-prose pre {
      background-color: #09090b !important;
      border: 1px solid #27272a;
      border-radius: 0.5rem;
      padding: 1rem;
      overflow-x: auto;
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      font-size: 0.825rem;
      line-height: 1.6;
      margin: 1.25rem 0;
    }
    .light .blog-prose pre {
      background-color: #f4f4f5 !important;
      border-color: #e4e4e7;
    }

    .blog-prose code:not(pre code) {
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      font-size: 0.85em;
      background-color: rgba(255, 255, 255, 0.08);
      color: #00a2ff;
      padding: 0.15rem 0.35rem;
      border-radius: 0.25rem;
    }
    .light .blog-prose code:not(pre code) {
      background-color: rgba(0, 0, 0, 0.06);
      color: #0070f3;
    }

    .blog-prose hr {
      border: 0;
      border-top: 1px solid rgba(255, 255, 255, 0.1);
      margin: 2rem 0;
    }
    .light .blog-prose hr {
      border-top-color: rgba(0, 0, 0, 0.1);
    }
  </style>
</Layout>
