---
import { SIMULATORS } from '../../../data/simulators-registry';
import SimulatorWorkspace from '../../../components/SimulatorWorkspace.astro';

export function getStaticPaths() {
  return SIMULATORS.map((sim) => ({
    params: {
      category: sim.category,
      tool: sim.id
    },
    props: {
      tool: sim
    }
  }));
}

const { tool } = Astro.props;
---

<SimulatorWorkspace tool={tool} />
