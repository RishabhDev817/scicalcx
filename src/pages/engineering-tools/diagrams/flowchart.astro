---
import Layout from '../../../layouts/Layout.astro';
---

<Layout 
  activeTab="engineering-tools"
  title="Interactive Flowchart & UML Class Builder | SciCalcX"
  description="Build flowcharts, UML diagrams, network diagrams, and basic floor plans. Drag-and-drop shapes, connect elements with auto-aligning lines, and extend structures with action buttons."
>
  <div class="w-full space-y-6">
    <!-- Header bar -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between border-b border-brand-border/60 pb-4 gap-4">
      <div class="space-y-1">
        <a href="/engineering-tools" class="text-xs font-mono text-brand-blue-neon hover:underline">
          &larr; Back to Tools Hub
        </a>
        <h1 class="text-2xl font-bold text-white tracking-tight">
          Flowchart & UML Builder<span class="text-brand-blue">.</span>
        </h1>
      </div>

      <div class="flex flex-wrap items-center gap-2">
        <select id="diagram-type-select" class="bg-brand-gray-dark border border-brand-border text-xs rounded px-2.5 py-1.5 focus:outline-none focus:border-brand-blue text-white cursor-pointer">
          <option value="flowchart">Flowchart Symbols</option>
          <option value="uml">UML (OOP) Symbols</option>
          <option value="network">Network IT Symbols</option>
          <option value="floorplan">Floor Plan Symbols</option>
        </select>

        <select id="template-select" class="bg-brand-gray-dark border border-brand-border text-xs rounded px-2.5 py-1.5 focus:outline-none focus:border-brand-blue text-white cursor-pointer">
          <option value="">-- Load Template --</option>
          <option value="flow-basic">Algorithm Flowchart</option>
          <option value="uml-class">UML Class Hierarchy</option>
          <option value="network-lan">LAN Topology</option>
        </select>
        
        <button id="btn-export-svg" class="text-xs px-3 py-1.5 border border-brand-border bg-brand-black hover:bg-brand-gray-hover text-brand-blue-neon rounded transition-colors cursor-pointer">Export SVG</button>
        <button id="btn-clear-canvas" class="text-xs px-3 py-1.5 border border-brand-border bg-brand-black hover:bg-red-500/10 text-red-400 hover:text-white rounded transition-colors cursor-pointer">Clear</button>
      </div>
    </div>

    <!-- Workspace Grid Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-4 gap-6">
      <!-- Sidebars (Shapes & Editor Properties) -->
      <div class="lg:col-span-1 space-y-4">
        <!-- Draggable Shapes Palette -->
        <div class="border border-brand-border bg-brand-gray-dark/40 rounded-xl p-4 space-y-3">
          <h2 class="text-xs font-semibold uppercase tracking-wider text-white font-mono">
            🔲 Symbols Palette
          </h2>
          <p class="text-[10px] text-brand-text-muted">
            Click shapes to spawn them onto the center of the canvas board:
          </p>

          <!-- Flowchart Shapes -->
          <div id="palette-flowchart" class="grid grid-cols-2 gap-2 text-[10px] font-mono">
            <button class="palette-item py-2 border border-brand-border bg-brand-black hover:bg-brand-gray-hover text-white rounded cursor-pointer" data-shape-type="terminator">Terminator</button>
            <button class="palette-item py-2 border border-brand-border bg-brand-black hover:bg-brand-gray-hover text-white rounded cursor-pointer" data-shape-type="process">Process</button>
            <button class="palette-item py-2 border border-brand-border bg-brand-black hover:bg-brand-gray-hover text-white rounded cursor-pointer" data-shape-type="decision">Decision</button>
            <button class="palette-item py-2 border border-brand-border bg-brand-black hover:bg-brand-gray-hover text-white rounded cursor-pointer" data-shape-type="io">Data I/O</button>
          </div>

          <!-- UML Shapes -->
          <div id="palette-uml" class="grid grid-cols-2 gap-2 text-[10px] font-mono hidden">
            <button class="palette-item py-2 border border-brand-border bg-brand-black hover:bg-brand-gray-hover text-white rounded cursor-pointer" data-shape-type="uml-class">UML Class</button>
            <button class="palette-item py-2 border border-brand-border bg-brand-black hover:bg-brand-gray-hover text-white rounded cursor-pointer" data-shape-type="usecase">Use Case</button>
            <button class="palette-item py-2 border border-brand-border bg-brand-black hover:bg-brand-gray-hover text-white rounded cursor-pointer" data-shape-type="actor">Actor</button>
            <button class="palette-item py-2 border border-brand-border bg-brand-black hover:bg-brand-gray-hover text-white rounded cursor-pointer" data-shape-type="state">State</button>
          </div>

          <!-- Network Shapes -->
          <div id="palette-network" class="grid grid-cols-2 gap-2 text-[10px] font-mono hidden">
            <button class="palette-item py-2 border border-brand-border bg-brand-black hover:bg-brand-gray-hover text-white rounded cursor-pointer" data-shape-type="net-server">Server</button>
            <button class="palette-item py-2 border border-brand-border bg-brand-black hover:bg-brand-gray-hover text-white rounded cursor-pointer" data-shape-type="net-db">Database</button>
            <button class="palette-item py-2 border border-brand-border bg-brand-black hover:bg-brand-gray-hover text-white rounded cursor-pointer" data-shape-type="net-router">Router</button>
            <button class="palette-item py-2 border border-brand-border bg-brand-black hover:bg-brand-gray-hover text-white rounded cursor-pointer" data-shape-type="net-cloud">Cloud</button>
          </div>

          <!-- Floor Plan Shapes -->
          <div id="palette-floorplan" class="grid grid-cols-2 gap-2 text-[10px] font-mono hidden">
            <button class="palette-item py-2 border border-brand-border bg-brand-black hover:bg-brand-gray-hover text-white rounded cursor-pointer" data-shape-type="room">Room Box</button>
            <button class="palette-item py-2 border border-brand-border bg-brand-black hover:bg-brand-gray-hover text-white rounded cursor-pointer" data-shape-type="wall">Wall Line</button>
            <button class="palette-item py-2 border border-brand-border bg-brand-black hover:bg-brand-gray-hover text-white rounded cursor-pointer" data-shape-type="door">Door</button>
          </div>
        </div>

        <!-- Selected Element properties controller -->
        <div id="property-editor-panel" class="border border-brand-border bg-brand-gray-dark/40 rounded-xl p-4 space-y-3 hidden">
          <h2 class="text-xs font-semibold uppercase tracking-wider text-brand-blue-neon font-mono">
            🔧 Edit Element
          </h2>
          
          <div class="space-y-2 text-[10px] font-mono">
            <div class="space-y-1">
              <label class="text-brand-text-muted">Shape Text / Name</label>
              <textarea 
                id="shape-text-editor" 
                class="w-full bg-brand-black border border-brand-border rounded p-1.5 text-white focus:outline-none focus:border-brand-blue resize-none h-16"
              ></textarea>
            </div>

            <div class="space-y-1">
              <label class="text-brand-text-muted">Fill Color Tone</label>
              <select id="shape-color-editor" class="w-full bg-brand-black border border-brand-border rounded p-1 text-white">
                <option value="rgba(0, 112, 243, 0.1)">Neon Blue (0.1)</option>
                <option value="rgba(16, 185, 129, 0.1)">Green (0.1)</option>
                <option value="rgba(245, 166, 35, 0.1)">Amber (0.1)</option>
                <option value="rgba(239, 68, 68, 0.1)">Red (0.1)</option>
                <option value="transparent">Transparent</option>
              </select>
            </div>

            <button id="btn-delete-element" class="w-full py-1.5 rounded bg-red-500/10 hover:bg-red-500 text-red-400 hover:text-white transition-colors cursor-pointer">
              Delete Shape
            </button>
          </div>
        </div>
      </div>

      <!-- Main Canvas Board -->
      <div class="lg:col-span-3 flex flex-col space-y-2">
        <div class="text-[10px] font-mono text-brand-text-muted flex items-center justify-between px-1">
          <span>💡 Action Buttons: Select a shape to see quick-append arrows (+) to grow flows.</span>
          <span>Click socket ports to draw custom connectors.</span>
        </div>

        <div class="border border-brand-border bg-brand-black rounded-2xl w-full h-[550px] relative overflow-hidden focus-neon-blue">
          <!-- Main Canvas SVG -->
          <svg 
            id="flow-canvas-svg" 
            class="w-full h-full cursor-grab active:cursor-grabbing bg-brand-black"
            xmlns="http://www.w3.org/2000/svg"
          >
            <!-- Grid pattern -->
            <defs>
              <pattern id="flow-grid-pattern" width="25" height="25" patternUnits="userSpaceOnUse">
                <path d="M 25 0 L 0 0 0 25" fill="none" stroke="rgba(255,255,255,0.03)" stroke-width="1" />
                <circle cx="0" cy="0" r="1" fill="rgba(255,255,255,0.1)" />
              </pattern>
              <!-- Arrow head definition -->
              <marker id="arrow-head" markerWidth="10" markerHeight="7" refX="8" refY="3.5" orient="auto">
                <polygon points="0 0, 10 3.5, 0 7" fill="#0070f3" />
              </marker>
            </defs>
            <rect width="100%" height="100%" fill="url(#flow-grid-pattern)" />
            
            <!-- Connection lines layer -->
            <g id="svg-connectors-layer"></g>

            <!-- Draggable shapes layer -->
            <g id="svg-shapes-layer"></g>

            <!-- Temporary active drawing line -->
            <path id="temp-routing-line" fill="none" stroke="#0070f3" stroke-width="2" stroke-dasharray="3" class="hidden" />

            <!-- Highlight/Overlay layer for selected node controls -->
            <g id="svg-overlays-layer"></g>
          </svg>
        </div>
      </div>
    </div>
  </div>

  <!-- Client-side Diagram Editor Script -->
  <script>
    interface Shape {
      id: string;
      type: string;
      text: string;
      x: number;
      y: number;
      w: number;
      h: number;
      color: string;
    }

    interface Connector {
      id: string;
      fromId: string;
      toId: string;
      fromPort: string;
      toPort: string;
    }

    // STATE VARIABLES
    let shapes: Shape[] = [];
    let connectors: Connector[] = [];
    let selectedShapeId: string | null = null;
    
    // Drag-drop & drawing connectors state
    let dragShape: { id: string; offsetX: number; offsetY: number } | null = null;
    let activeDrawingPort: { shapeId: string; port: string; startX: number; startY: number } | null = null;

    // SVG elements
    const canvasSvg = document.getElementById('flow-canvas-svg') as any;
    const svgShapesLayer = document.getElementById('svg-shapes-layer')!;
    const svgConnectorsLayer = document.getElementById('svg-connectors-layer')!;
    const svgOverlaysLayer = document.getElementById('svg-overlays-layer')!;
    const tempLine = document.getElementById('temp-routing-line') as any;

    // Palette visibility toggle based on type selection
    const typeSelect = document.getElementById('diagram-type-select') as HTMLSelectElement;
    typeSelect.addEventListener('change', () => {
      const type = typeSelect.value;
      document.getElementById('palette-flowchart')?.classList.add('hidden');
      document.getElementById('palette-uml')?.classList.add('hidden');
      document.getElementById('palette-network')?.classList.add('hidden');
      document.getElementById('palette-floorplan')?.classList.add('hidden');

      if (type === 'flowchart') document.getElementById('palette-flowchart')?.classList.remove('hidden');
      else if (type === 'uml') document.getElementById('palette-uml')?.classList.remove('hidden');
      else if (type === 'network') document.getElementById('palette-network')?.classList.remove('hidden');
      else if (type === 'floorplan') document.getElementById('palette-floorplan')?.classList.remove('hidden');
    });

    // Clear Canvas
    document.getElementById('btn-clear-canvas')?.addEventListener('click', () => {
      shapes = [];
      connectors = [];
      selectedShapeId = null;
      updateSidebar();
      render();
    });

    // --- TEMPLATES LOADER ---
    const templateSelect = document.getElementById('template-select') as HTMLSelectElement;
    templateSelect.addEventListener('change', () => {
      const val = templateSelect.value;
      if (val === 'flow-basic') loadBasicFlowTemplate();
      else if (val === 'uml-class') loadUmlClassTemplate();
      else if (val === 'network-lan') loadNetworkLanTemplate();
    });

    function loadBasicFlowTemplate() {
      shapes = [
        { id: 's1', type: 'terminator', text: 'Start Process', x: 200, y: 50, w: 100, h: 40, color: 'rgba(0, 112, 243, 0.1)' },
        { id: 's2', type: 'io', text: 'Input Integer N', x: 200, y: 140, w: 110, h: 45, color: 'rgba(245, 166, 35, 0.1)' },
        { id: 's3', type: 'decision', text: 'Is N > 0?', x: 200, y: 240, w: 100, h: 60, color: 'rgba(239, 68, 68, 0.1)' },
        { id: 's4', type: 'process', text: 'N = N - 1', x: 380, y: 250, w: 90, h: 40, color: 'rgba(16, 185, 129, 0.1)' },
        { id: 's5', type: 'terminator', text: 'Stop Process', x: 200, y: 360, w: 100, h: 40, color: 'rgba(0, 112, 243, 0.1)' }
      ];
      connectors = [
        { id: 'c1', fromId: 's1', toId: 's2', fromPort: 'bottom', toPort: 'top' },
        { id: 'c2', fromId: 's2', toId: 's3', fromPort: 'bottom', toPort: 'top' },
        { id: 'c3', fromId: 's3', toId: 's4', fromPort: 'right', toPort: 'left' },
        { id: 'c4', fromId: 's3', toId: 's5', fromPort: 'bottom', toPort: 'top' }
      ];
      selectedShapeId = 's1';
      updateSidebar();
      render();
    }

    function loadUmlClassTemplate() {
      shapes = [
        { id: 'u1', type: 'uml-class', text: 'Vehicle\n--\n+ speed: float\n--\n+ drive(): void', x: 100, y: 100, w: 120, h: 80, color: 'rgba(0, 112, 243, 0.1)' },
        { id: 'u2', type: 'uml-class', text: 'Car\n--\n+ wheels: int\n--\n+ honk(): void', x: 100, y: 280, w: 120, h: 80, color: 'rgba(16, 185, 129, 0.1)' }
      ];
      connectors = [
        { id: 'uc1', fromId: 'u2', toId: 'u1', fromPort: 'top', toPort: 'bottom' }
      ];
      selectedShapeId = 'u1';
      updateSidebar();
      render();
    }

    function loadNetworkLanTemplate() {
      shapes = [
        { id: 'n1', type: 'net-cloud', text: 'Internet Service', x: 300, y: 50, w: 80, h: 60, color: 'transparent' },
        { id: 'n2', type: 'net-router', text: 'Main Gateway', x: 300, y: 180, w: 60, h: 60, color: 'transparent' },
        { id: 'n3', type: 'net-server', text: 'App server', x: 150, y: 300, w: 60, h: 70, color: 'transparent' },
        { id: 'n4', type: 'net-db', text: 'MySQL database', x: 450, y: 300, w: 60, h: 70, color: 'transparent' }
      ];
      connectors = [
        { id: 'nc1', fromId: 'n1', toId: 'n2', fromPort: 'bottom', toPort: 'top' },
        { id: 'nc2', fromId: 'n2', toId: 'n3', fromPort: 'bottom', toPort: 'top' },
        { id: 'nc3', fromId: 'n2', toId: 'n4', fromPort: 'bottom', toPort: 'top' }
      ];
      selectedShapeId = 'n1';
      updateSidebar();
      render();
    }

    // Spawn elements from palette click
    document.querySelectorAll('.palette-item').forEach((btn: any) => {
      btn.addEventListener('click', () => {
        const type = btn.getAttribute('data-shape-type');
        spawnShape(type);
      });
    });

    function spawnShape(type: string, x = 200, y = 200) {
      const id = `shape_${Date.now()}`;
      const defaultTexts: Record<string, string> = {
        terminator: 'Start/End',
        process: 'Standard Task',
        decision: 'Condition?',
        io: 'Data Input/Output',
        'uml-class': 'Class\n--\n+ field: type\n--\n+ method()',
        usecase: 'Use Case',
        actor: 'User / Client',
        state: 'Active State',
        'net-server': 'Server',
        'net-db': 'Database',
        'net-router': 'Router',
        'net-cloud': 'Cloud',
        room: 'Lab Room',
        wall: 'Partition Wall',
        door: 'Access Door'
      };

      shapes.push({
        id,
        type,
        text: defaultTexts[type] || 'New Item',
        x,
        y,
        w: type.startsWith('net-') ? 60 : 100,
        h: type.startsWith('net-') ? 60 : 40,
        color: type.startsWith('net-') ? 'transparent' : 'rgba(0, 112, 243, 0.1)'
      });

      selectedShapeId = id;
      updateSidebar();
      render();
    }

    // --- DRAWING PORT CALCULATIONS ---
    function getPortCoords(shape: Shape, port: string) {
      switch (port) {
        case 'top': return { x: shape.x + shape.w / 2, y: shape.y };
        case 'bottom': return { x: shape.x + shape.w / 2, y: shape.y + shape.h };
        case 'left': return { x: shape.x, y: shape.y + shape.h / 2 };
        case 'right': return { x: shape.x + shape.w, y: shape.y + shape.h / 2 };
        default: return { x: shape.x, y: shape.y };
      }
    }

    // --- RENDER ENGINE ---
    function render() {
      // Clear layers
      svgShapesLayer.innerHTML = '';
      svgConnectorsLayer.innerHTML = '';
      svgOverlaysLayer.innerHTML = '';

      // Draw Connectors
      connectors.forEach(conn => {
        const fromShape = shapes.find(s => s.id === conn.fromId);
        const toShape = shapes.find(s => s.id === conn.toId);
        if (fromShape && toShape) {
          const start = getPortCoords(fromShape, conn.fromPort);
          const end = getPortCoords(toShape, conn.toPort);

          const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
          // Smooth bezier curve connector routing
          const dx = Math.abs(end.x - start.x) * 0.4;
          const dy = Math.abs(end.y - start.y) * 0.4;
          
          let d = `M ${start.x} ${start.y} C ${start.x + dx} ${start.y}, ${end.x - dx} ${end.y}, ${end.x} ${end.y}`;
          if (conn.fromPort === 'bottom' || conn.fromPort === 'top') {
            d = `M ${start.x} ${start.y} C ${start.x} ${start.y + (conn.fromPort === 'bottom' ? dy : -dy)}, ${end.x} ${end.y + (conn.toPort === 'top' ? -dy : dy)}, ${end.x} ${end.y}`;
          }

          path.setAttribute('d', d);
          path.setAttribute('fill', 'none');
          path.setAttribute('stroke', '#0070f3');
          path.setAttribute('stroke-width', '1.8');
          path.setAttribute('marker-end', 'url(#arrow-head)');

          svgConnectorsLayer.appendChild(path);
        }
      });

      // Draw Shapes
      shapes.forEach(shape => {
        const isSelected = selectedShapeId === shape.id;
        const g = document.createElementNS('http://www.w3.org/2000/svg', 'g');
        g.setAttribute('transform', `translate(${shape.x}, ${shape.y})`);

        let shapeSVG = '';
        const fill = shape.color;
        const stroke = isSelected ? '#0070f3' : '#1e1e1e';
        const strokeW = isSelected ? '2.5' : '1.5';

        // Render geometry based on type
        if (shape.type === 'process') {
          shapeSVG = `<rect width="${shape.w}" height="${shape.h}" fill="${fill}" stroke="${stroke}" stroke-width="${strokeW}" rx="4" />`;
        } else if (shape.type === 'terminator') {
          shapeSVG = `<rect width="${shape.w}" height="${shape.h}" fill="${fill}" stroke="${stroke}" stroke-width="${strokeW}" rx="20" ry="20" />`;
        } else if (shape.type === 'decision') {
          const hw = shape.w / 2;
          const hh = shape.h / 2;
          shapeSVG = `<polygon points="${hw},0 ${shape.w},${hh} ${hw},${shape.h} 0,${hh}" fill="${fill}" stroke="${stroke}" stroke-width="${strokeW}" />`;
        } else if (shape.type === 'io') {
          shapeSVG = `<polygon points="12,0 ${shape.w},0 ${shape.w - 12},${shape.h} 0,${shape.h}" fill="${fill}" stroke="${stroke}" stroke-width="${strokeW}" />`;
        } else if (shape.type === 'usecase') {
          shapeSVG = `<ellipse cx="${shape.w/2}" cy="${shape.h/2}" rx="${shape.w/2}" ry="${shape.h/2}" fill="${fill}" stroke="${stroke}" stroke-width="${strokeW}" />`;
        } else if (shape.type === 'state') {
          shapeSVG = `<rect width="${shape.w}" height="${shape.h}" fill="${fill}" stroke="${stroke}" stroke-width="${strokeW}" rx="10" />`;
        } else if (shape.type === 'actor') {
          // Stick figure actor
          shapeSVG = `
            <ellipse cx="${shape.w/2}" cy="10" rx="8" ry="8" fill="${fill}" stroke="${stroke}" stroke-width="${strokeW}" />
            <line x1="${shape.w/2}" y1="18" x2="${shape.w/2}" y2="35" stroke="${stroke}" stroke-width="${strokeW}" />
            <line x1="${shape.w/2 - 12}" y1="24" x2="${shape.w/2 + 12}" y2="24" stroke="${stroke}" stroke-width="${strokeW}" />
            <line x1="${shape.w/2}" y1="35" x2="${shape.w/2 - 10}" y2="50" stroke="${stroke}" stroke-width="${strokeW}" />
            <line x1="${shape.w/2}" y1="35" x2="${shape.w/2 + 10}" y2="50" stroke="${stroke}" stroke-width="${strokeW}" />
          `;
        } else if (shape.type === 'uml-class') {
          shapeSVG = `
            <rect width="${shape.w}" height="${shape.h}" fill="${fill}" stroke="${stroke}" stroke-width="${strokeW}" rx="4" />
            <line x1="0" y1="22" x2="${shape.w}" y2="22" stroke="${stroke}" stroke-width="${strokeW}" />
            <line x1="0" y1="46" x2="${shape.w}" y2="46" stroke="${stroke}" stroke-width="${strokeW}" />
          `;
        } else if (shape.type.startsWith('net-')) {
          // Render vector representations of servers/databases
          let iconPath = '';
          if (shape.type === 'net-db') { // Cylinder
            iconPath = `
              <ellipse cx="${shape.w/2}" cy="12" rx="18" ry="6" fill="#1f1f1f" stroke="${stroke}" stroke-width="${strokeW}" />
              <path d="M ${shape.w/2 - 18} 12 L ${shape.w/2 - 18} 30 A 18 6 0 0 0 ${shape.w/2 + 18} 30 L ${shape.w/2 + 18} 12" fill="#1f1f1f" stroke="${stroke}" stroke-width="${strokeW}" />
              <path d="M ${shape.w/2 - 18} 30 L ${shape.w/2 - 18} 48 A 18 6 0 0 0 ${shape.w/2 + 18} 48 L ${shape.w/2 + 18} 30" fill="#1f1f1f" stroke="${stroke}" stroke-width="${strokeW}" />
            `;
          } else if (shape.type === 'net-server') { // Stack of boxes
            iconPath = `
              <rect x="${shape.w/2 - 16}" y="6" width="32" height="12" fill="#1f1f1f" stroke="${stroke}" stroke-width="${strokeW}" rx="2" />
              <rect x="${shape.w/2 - 16}" y="22" width="32" height="12" fill="#1f1f1f" stroke="${stroke}" stroke-width="${strokeW}" rx="2" />
              <rect x="${shape.w/2 - 16}" y="38" width="32" height="12" fill="#1f1f1f" stroke="${stroke}" stroke-width="${strokeW}" rx="2" />
            `;
          } else if (shape.type === 'net-router') { // Circular arrows disc
            iconPath = `
              <circle cx="${shape.w/2}" cy="${shape.h/2}" r="22" fill="#1f1f1f" stroke="${stroke}" stroke-width="${strokeW}" />
              <path d="M ${shape.w/2 - 14} ${shape.h/2} L ${shape.w/2 + 14} ${shape.h/2}" stroke="${stroke}" stroke-width="${strokeW}" />
              <path d="M ${shape.w/2} ${shape.h/2 - 14} L ${shape.w/2} ${shape.h/2 + 14}" stroke="${stroke}" stroke-width="${strokeW}" />
            `;
          } else { // Cloud path
            iconPath = `<path d="M 12,30 A 10,10 0 0,1 24,15 A 15,15 0 0,1 50,15 A 12,12 0 0,1 50,38 L 16,38 A 10,10 0 0,1 12,30 Z" fill="#1f1f1f" stroke="${stroke}" stroke-width="${strokeW}" />`;
          }
          shapeSVG = iconPath;
        } else if (shape.type === 'room') {
          shapeSVG = `<rect width="${shape.w}" height="${shape.h}" fill="transparent" stroke="${stroke}" stroke-width="3" />`;
        } else if (shape.type === 'wall') {
          shapeSVG = `<line x1="0" y1="${shape.h/2}" x2="${shape.w}" y2="${shape.h/2}" stroke="${stroke}" stroke-width="5" />`;
        } else { // Door
          shapeSVG = `
            <path d="M 0 ${shape.h} A ${shape.w} ${shape.h} 0 0 1 ${shape.w} 0" fill="none" stroke="${stroke}" stroke-width="2" stroke-dasharray="3" />
            <line x1="0" y1="0" x2="0" y2="${shape.h}" stroke="${stroke}" stroke-width="3" />
          `;
        }

        // Inside labels text spacing
        let textLines = shape.text.split('\n');
        let textSVG = '';
        if (shape.type === 'uml-class') {
          // Custom render for UML fields alignment
          textSVG += `<text x="8" y="15" fill="#ffffff" font-size="9" font-family="font-mono, monospace" font-weight="bold">${textLines[0] || 'Class'}</text>`;
          textSVG += `<text x="8" y="36" fill="#888888" font-size="8" font-family="sans-serif">${textLines[1] || ''}</text>`;
          textSVG += `<text x="8" y="60" fill="#888888" font-size="8" font-family="sans-serif">${textLines[2] || ''}</text>`;
        } else if (!shape.type.startsWith('net-') || isSelected) {
          const fontColor = shape.type.startsWith('net-') ? '#888888' : (isSelected ? '#0070f3' : '#ffffff');
          const dy = shape.type.startsWith('net-') ? shape.h + 12 : (shape.h / 2 + 3);
          textSVG = `<text x="${shape.w/2}" y="${dy}" fill="${fontColor}" font-size="10" font-family="sans-serif" text-anchor="middle" font-weight="500">${textLines[0]}</text>`;
        }

        g.innerHTML = `
          ${shapeSVG}
          ${textSVG}
        `;

        // DRAG EVENT LISTENERS
        g.addEventListener('mousedown', (e: any) => {
          e.stopPropagation();
          selectedShapeId = shape.id;
          updateSidebar();
          const rect = canvasSvg.getBoundingClientRect();
          dragShape = {
            id: shape.id,
            offsetX: e.clientX - rect.left - shape.x,
            offsetY: e.clientY - rect.top - shape.y
          };
          render();
        });

        // Double click to edit shape text
        g.addEventListener('dblclick', () => {
          const val = prompt('Edit Shape Text (use \\n for new lines):', shape.text);
          if (val !== null) {
            shape.text = val;
            updateSidebar();
            render();
          }
        });

        svgShapesLayer.appendChild(g);

        // Render Action Buttons & Ports Overlays if Selected
        if (isSelected) {
          const overlay = document.createElementNS('http://www.w3.org/2000/svg', 'g');
          overlay.setAttribute('transform', `translate(${shape.x}, ${shape.y})`);

          // Draw port nodes (circles at edges)
          const ports = ['top', 'right', 'bottom', 'left'];
          ports.forEach(port => {
            const coords = getPortCoords({ ...shape, x: 0, y: 0 }, port);
            const circle = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
            circle.setAttribute('cx', String(coords.x));
            circle.setAttribute('cy', String(coords.y));
            circle.setAttribute('r', '5');
            circle.setAttribute('fill', '#0070f3');
            circle.setAttribute('stroke', '#ffffff');
            circle.setAttribute('stroke-width', '1');
            circle.setAttribute('class', 'port-node cursor-crosshair');

            circle.addEventListener('mousedown', (e: any) => {
              e.stopPropagation();
              e.preventDefault();
              const canvasRect = canvasSvg.getBoundingClientRect();
              activeDrawingPort = {
                shapeId: shape.id,
                port,
                startX: shape.x + coords.x,
                startY: shape.y + coords.y
              };
              tempLine.classList.remove('hidden');
            });

            overlay.appendChild(circle);
          });

          // Draw Flowchart Action Buttons (arrows for quick-extend)
          const offset = 22;
          const arrows = [
            { dir: 'up', dx: shape.w/2, dy: -offset, angle: 270, ox: 0, oy: -120 },
            { dir: 'right', dx: shape.w + offset, dy: shape.h/2, angle: 0, ox: 150, oy: 0 },
            { dir: 'down', dx: shape.w/2, dy: shape.h + offset, angle: 90, ox: 0, oy: 120 },
            { dir: 'left', dx: -offset, dy: shape.h/2, angle: 180, ox: -150, oy: 0 }
          ];

          arrows.forEach(arr => {
            const btn = document.createElementNS('http://www.w3.org/2000/svg', 'g');
            btn.setAttribute('transform', `translate(${arr.dx}, ${arr.dy}) rotate(${arr.angle})`);
            btn.setAttribute('class', 'quick-extend-arrow cursor-pointer');
            btn.innerHTML = `
              <circle cx="0" cy="0" r="8" fill="#0070f3" stroke="#ffffff" stroke-width="1" />
              <path d="M -3 -3 L 2 0 L -3 3" fill="none" stroke="#ffffff" stroke-width="1.5" />
            `;

            btn.addEventListener('mousedown', (e) => {
              e.stopPropagation();
              e.preventDefault();
              // Spawn a connected node in that direction!
              const targetX = shape.x + arr.ox;
              const targetY = shape.y + arr.oy;
              const newId = `shape_${Date.now()}`;
              
              // Add Shape
              shapes.push({
                id: newId,
                type: shape.type,
                text: 'Connected Step',
                x: Math.max(20, Math.min(canvasSvg.clientWidth - 110, targetX)),
                y: Math.max(20, Math.min(canvasSvg.clientHeight - 60, targetY)),
                w: shape.w,
                h: shape.h,
                color: shape.color
              });

              // Add Connector Line
              const fromPort = arr.dir === 'up' ? 'top' : (arr.dir === 'down' ? 'bottom' : arr.dir);
              const toPort = arr.dir === 'up' ? 'bottom' : (arr.dir === 'down' ? 'top' : (arr.dir === 'right' ? 'left' : 'right'));
              
              connectors.push({
                id: `conn_${Date.now()}`,
                fromId: shape.id,
                toId: newId,
                fromPort,
                toPort
              });

              selectedShapeId = newId;
              updateSidebar();
              render();
            });

            overlay.appendChild(btn);
          });

          svgOverlaysLayer.appendChild(overlay);
        }
      });
    }

    // --- MOUSE MOVEMENT ROUTING FOR PORTS & SHAPES ---
    canvasSvg.addEventListener('mousemove', (e: any) => {
      const rect = canvasSvg.getBoundingClientRect();
      const mouseX = e.clientX - rect.left;
      const mouseY = e.clientY - rect.top;

      // Handle Shape Dragging
      if (dragShape) {
        const shape = shapes.find(s => s.id === dragShape!.id);
        if (shape) {
          shape.x = mouseX - dragShape.offsetX;
          shape.y = mouseY - dragShape.offsetY;
          render();
        }
      }

      // Handle Connector Line Drawing Trace
      if (activeDrawingPort) {
        tempLine.setAttribute('d', `M ${activeDrawingPort.startX} ${activeDrawingPort.startY} L ${mouseX} ${mouseY}`);
      }
    });

    // Mouse up handler to complete draw connector lines
    window.addEventListener('mouseup', (e: any) => {
      dragShape = null;

      if (activeDrawingPort) {
        tempLine.classList.add('hidden');
        
        // Check if mouse is released over a port node of *another* shape
        const target = e.target;
        if (target && target.classList.contains('port-node')) {
          // Identify target shape and port
          const targetG = target.parentNode;
          // Look up corresponding coordinates on overlays layer
          const targetShapeId = selectedShapeId; // Simple connection helper
          
          if (targetShapeId && targetShapeId !== activeDrawingPort.shapeId) {
            // Find which port is closest to release point
            const tShape = shapes.find(s => s.id === targetShapeId);
            if (tShape) {
              const rect = canvasSvg.getBoundingClientRect();
              const mX = e.clientX - rect.left;
              const mY = e.clientY - rect.top;

              // Find closest port
              const ports = ['top', 'right', 'bottom', 'left'];
              let closestPort = 'top';
              let minDist = 999999;
              
              ports.forEach(p => {
                const pc = getPortCoords(tShape, p);
                const d = Math.sqrt((pc.x - mX)**2 + (pc.y - mY)**2);
                if (d < minDist) {
                  minDist = d;
                  closestPort = p;
                }
              });

              connectors.push({
                id: `conn_${Date.now()}`,
                fromId: activeDrawingPort.shapeId,
                toId: targetShapeId,
                fromPort: activeDrawingPort.port,
                toPort: closestPort
              });
            }
          }
        }
        activeDrawingPort = null;
        render();
      }
    });

    // --- SIDEBAR PROPERTIES EDITOR ---
    const propPanel = document.getElementById('property-editor-panel')!;
    const textEditor = document.getElementById('shape-text-editor') as HTMLTextAreaElement;
    const colorEditor = document.getElementById('shape-color-editor') as HTMLSelectElement;

    function updateSidebar() {
      if (selectedShapeId) {
        const shape = shapes.find(s => s.id === selectedShapeId);
        if (shape) {
          propPanel.classList.remove('hidden');
          textEditor.value = shape.text;
          colorEditor.value = shape.color;
          return;
        }
      }
      propPanel.classList.add('hidden');
    }

    textEditor.addEventListener('input', () => {
      if (selectedShapeId) {
        const shape = shapes.find(s => s.id === selectedShapeId);
        if (shape) {
          shape.text = textEditor.value;
          render();
        }
      }
    });

    colorEditor.addEventListener('change', () => {
      if (selectedShapeId) {
        const shape = shapes.find(s => s.id === selectedShapeId);
        if (shape) {
          shape.color = colorEditor.value;
          render();
        }
      }
    });

    document.getElementById('btn-delete-element')?.addEventListener('click', () => {
      if (selectedShapeId) {
        shapes = shapes.filter(s => s.id !== selectedShapeId);
        connectors = connectors.filter(c => c.fromId !== selectedShapeId && c.toId !== selectedShapeId);
        selectedShapeId = null;
        updateSidebar();
        render();
      }
    });

    // --- SVG IMAGE EXPORTER ---
    document.getElementById('btn-export-svg')?.addEventListener('click', () => {
      const serializer = new XMLSerializer();
      const svgStr = serializer.serializeToString(canvasSvg);
      const blob = new Blob([svgStr], { type: 'image/svg+xml;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const link = document.createElement('a');
      link.href = url;
      link.download = 'diagram.svg';
      link.click();
    });

    // Initial load
    loadBasicFlowTemplate();
  </script>
</Layout>
