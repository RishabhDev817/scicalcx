---
import Layout from '../../../layouts/Layout.astro';
---

<Layout 
  activeTab="engineering-tools"
  title="Interactive Database ER Diagram Designer | SciCalcX"
  description="Model relational database schemas client-side. Paste SQL CREATE TABLE statements to auto-diagram PK/FK keys, or build and edit tables manually. Exports to SQL and PNG images."
>
  <div class="w-full space-y-6">
    <!-- Header Controls -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between border-b border-brand-border/60 pb-4 gap-4">
      <div class="space-y-1">
        <a href="/engineering-tools" class="text-xs font-mono text-brand-blue-neon hover:underline">
          &larr; Back to Tools Hub
        </a>
        <h1 class="text-2xl font-bold text-white tracking-tight">
          Database ER Diagram Designer<span class="text-brand-blue">.</span>
        </h1>
      </div>

      <div class="flex flex-wrap items-center gap-2">
        <select id="template-select" class="bg-brand-gray-dark border border-brand-border text-xs rounded px-2.5 py-1.5 focus:outline-none focus:border-brand-blue text-white cursor-pointer">
          <option value="">-- Load Starter Template --</option>
          <option value="ecommerce">E-Commerce Schema</option>
          <option value="library">Library Management</option>
          <option value="hostel">Hostel Attendance</option>
        </select>
        
        <button id="btn-export-sql" class="text-xs px-3 py-1.5 border border-brand-border bg-brand-black hover:bg-brand-gray-hover text-white rounded transition-colors cursor-pointer">Export SQL</button>
        <button id="btn-export-json" class="text-xs px-3 py-1.5 border border-brand-border bg-brand-black hover:bg-brand-gray-hover text-white rounded transition-colors cursor-pointer">Export JSON</button>
        <button id="btn-export-png" class="text-xs px-3 py-1.5 border border-brand-border bg-brand-black hover:bg-brand-gray-hover text-brand-blue-neon rounded transition-colors cursor-pointer">Export Image</button>
        <button id="btn-auto-align" class="text-xs px-3 py-1.5 border border-brand-border bg-brand-black hover:bg-brand-gray-hover text-white rounded transition-colors cursor-pointer">Auto-Align</button>
        <button id="btn-clear-canvas" class="text-xs px-3 py-1.5 border border-brand-border bg-brand-black hover:bg-red-500/10 text-red-400 hover:text-white rounded transition-colors cursor-pointer">Clear</button>
      </div>
    </div>

    <!-- Workspace Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-4 gap-6">
      <!-- Sidebar Control Panels -->
      <div class="lg:col-span-1 space-y-4">
        <!-- SQL Import / Paste -->
        <div class="border border-brand-border bg-brand-gray-dark/40 rounded-xl p-4 space-y-3">
          <h2 class="text-xs font-semibold uppercase tracking-wider text-white font-mono flex items-center gap-1.5">
            📝 Import SQL DDL
          </h2>
          <p class="text-[10px] text-brand-text-muted">
            Paste SQL statements to auto-generate tables and relationships:
          </p>
          <textarea
            id="sql-import-input"
            class="w-full h-32 bg-brand-black hover:border-brand-border-hover focus:border-brand-blue border border-brand-border rounded p-2 text-[10px] font-mono text-white focus:outline-none resize-none"
            placeholder="CREATE TABLE users (&#10;  id INT PRIMARY KEY,&#10;  name VARCHAR(50)&#10;);"
          ></textarea>
          <button id="btn-import-sql" class="w-full py-1.5 rounded bg-brand-blue hover:bg-brand-blue-hover text-white text-xs font-semibold transition-colors cursor-pointer">
            Parse & Generate
          </button>
        </div>

        <!-- Manual Table / Card Editor -->
        <div id="table-editor-panel" class="border border-brand-border bg-brand-gray-dark/40 rounded-xl p-4 space-y-3 hidden">
          <h2 class="text-xs font-semibold uppercase tracking-wider text-brand-blue-neon font-mono flex items-center gap-1.5">
            🔧 Edit Table: <span id="edit-table-title" class="text-white">--</span>
          </h2>
          
          <div class="space-y-2">
            <button id="btn-add-col" class="w-full py-1 text-[10px] font-mono border border-brand-border bg-brand-black hover:bg-brand-gray-hover text-white rounded transition-all cursor-pointer">
              [ + Add Column ]
            </button>
          </div>

          <div id="column-list-fields" class="space-y-2 max-h-48 overflow-y-auto pr-1">
            <!-- Dynamically populated column editor inputs -->
          </div>

          <button id="btn-delete-table" class="w-full py-1.5 rounded bg-red-500/10 hover:bg-red-500 text-red-400 hover:text-white text-[10px] font-mono transition-colors cursor-pointer">
            [ Delete Table ]
          </button>
        </div>

        <!-- Manual Element Builders -->
        <div class="border border-brand-border bg-brand-gray-dark/40 rounded-xl p-4 space-y-3">
          <h2 class="text-xs font-semibold uppercase tracking-wider text-white font-mono">
            🧱 Add Elements
          </h2>
          <div class="grid grid-cols-2 gap-2 text-[10px] font-mono">
            <button id="btn-create-table" class="py-1.5 border border-brand-border bg-brand-black hover:bg-brand-gray-hover text-white rounded cursor-pointer">+ Table</button>
            <button id="btn-add-note" class="py-1.5 border border-brand-border bg-brand-black hover:bg-brand-gray-hover text-white rounded cursor-pointer">+ Sticky Note</button>
            <button id="btn-add-group" class="py-1.5 border border-brand-border bg-brand-black hover:bg-brand-gray-hover text-white rounded cursor-pointer col-span-2">+ Domain Group Box</button>
          </div>
        </div>

        <!-- Version History -->
        <div class="border border-brand-border bg-brand-gray-dark/40 rounded-xl p-4 space-y-3">
          <h2 class="text-xs font-semibold uppercase tracking-wider text-white font-mono flex items-center justify-between">
            ⏳ Version History
            <button id="btn-history-save" class="text-[9px] text-brand-blue-neon hover:underline cursor-pointer">Save State</button>
          </h2>
          <div id="history-states-list" class="space-y-1.5 max-h-32 overflow-y-auto pr-1 text-[10px] font-mono text-brand-text-muted">
            <!-- Saves list -->
            <div class="text-center py-2 text-brand-text-dim text-[9px]">No historical states saved.</div>
          </div>
        </div>
      </div>

      <!-- Designer Canvas Workspace -->
      <div class="lg:col-span-3 flex flex-col space-y-2">
        <div class="text-[10px] font-mono text-brand-text-muted flex items-center justify-between px-1">
          <span>💡 TIP: Drag table headers to arrange. Click components to edit fields.</span>
          <span id="canvas-zoom-indicator">Scale: 100%</span>
        </div>

        <div class="border border-brand-border bg-brand-black rounded-2xl w-full h-[550px] relative overflow-hidden focus-neon-blue">
          <!-- Main SVG Canvas -->
          <svg 
            id="er-canvas-svg" 
            class="w-full h-full cursor-grab active:cursor-grabbing bg-brand-black"
            xmlns="http://www.w3.org/2000/svg"
          >
            <!-- Atmospheric grid pattern -->
            <defs>
              <pattern id="grid-pattern" width="30" height="30" patternUnits="userSpaceOnUse">
                <path d="M 30 0 L 0 0 0 30" fill="none" stroke="rgba(255,255,255,0.03)" stroke-width="1" />
              </pattern>
            </defs>
            <rect width="100%" height="100%" fill="url(#grid-pattern)" />
            
            <!-- Groups boundary layer -->
            <g id="svg-groups-layer"></g>

            <!-- Relationships lines layer -->
            <g id="svg-lines-layer"></g>

            <!-- Tables and Cards layer -->
            <g id="svg-tables-layer"></g>

            <!-- Sticky notes layer -->
            <g id="svg-notes-layer"></g>
          </svg>
        </div>
      </div>
    </div>
  </div>

  <!-- Client-side Interactive Schema Editor -->
  <script>
    interface Column {
      name: string;
      type: string;
      isPK: boolean;
      isFK: boolean;
    }

    interface Table {
      id: string;
      name: string;
      x: number;
      y: number;
      columns: Column[];
    }

    interface Relationship {
      id: string;
      fromTable: string;
      fromCol: string;
      toTable: string;
      toCol: string;
    }

    interface Note {
      id: string;
      text: string;
      x: number;
      y: number;
    }

    interface GroupBox {
      id: string;
      name: string;
      color: string;
      x: number;
      y: number;
      w: number;
      h: number;
    }

    // STATE VARIABLES
    let tables: Table[] = [];
    let relationships: Relationship[] = [];
    let notes: Note[] = [];
    let groupBoxes: GroupBox[] = [];
    let selectedTableId: string | null = null;
    let selectedNoteId: string | null = null;
    let selectedGroupId: string | null = null;

    // Drag-drop state tracking
    let dragElement: { type: 'table' | 'note' | 'group' | 'group-resize'; id: string; offsetX: number; offsetY: number } | null = null;

    // DOM selectors
    const canvasSvg = document.getElementById('er-canvas-svg') as any;
    const svgTablesLayer = document.getElementById('svg-tables-layer')!;
    const svgLinesLayer = document.getElementById('svg-lines-layer')!;
    const svgNotesLayer = document.getElementById('svg-notes-layer')!;
    const svgGroupsLayer = document.getElementById('svg-groups-layer')!;

    // Load presets
    const templateSelect = document.getElementById('template-select') as HTMLSelectElement;
    templateSelect.addEventListener('change', () => {
      const val = templateSelect.value;
      if (val === 'ecommerce') loadEcommerceTemplate();
      else if (val === 'library') loadLibraryTemplate();
      else if (val === 'hostel') loadHostelTemplate();
    });

    function clearWorkspace() {
      tables = [];
      relationships = [];
      notes = [];
      groupBoxes = [];
      selectedTableId = null;
      selectedNoteId = null;
      selectedGroupId = null;
      updateSidebar();
      render();
    }
    document.getElementById('btn-clear-canvas')?.addEventListener('click', clearWorkspace);

    // --- TEMPLATES LOADER ---
    function loadEcommerceTemplate() {
      tables = [
        { id: 'users', name: 'users', x: 50, y: 150, columns: [{ name: 'id', type: 'INT', isPK: true, isFK: false }, { name: 'email', type: 'VARCHAR(100)', isPK: false, isFK: false }, { name: 'password', type: 'VARCHAR(255)', isPK: false, isFK: false }] },
        { id: 'orders', name: 'orders', x: 300, y: 150, columns: [{ name: 'id', type: 'INT', isPK: true, isFK: false }, { name: 'user_id', type: 'INT', isPK: false, isFK: true }, { name: 'order_date', type: 'TIMESTAMP', isPK: false, isFK: false }, { name: 'total_amount', type: 'DECIMAL(10,2)', isPK: false, isFK: false }] },
        { id: 'order_items', name: 'order_items', x: 550, y: 150, columns: [{ name: 'id', type: 'INT', isPK: true, isFK: false }, { name: 'order_id', type: 'INT', isPK: false, isFK: true }, { name: 'product_id', type: 'INT', isPK: false, isFK: true }, { name: 'quantity', type: 'INT', isPK: false, isFK: false }] },
        { id: 'products', name: 'products', x: 425, y: 380, columns: [{ name: 'id', type: 'INT', isPK: true, isFK: false }, { name: 'title', type: 'VARCHAR(200)', isPK: false, isFK: false }, { name: 'price', type: 'DECIMAL(10,2)', isPK: false, isFK: false }] }
      ];
      relationships = [
        { id: 'rel_orders_user_id', fromTable: 'orders', fromCol: 'user_id', toTable: 'users', toCol: 'id' },
        { id: 'rel_items_order_id', fromTable: 'order_items', fromCol: 'order_id', toTable: 'orders', toCol: 'id' },
        { id: 'rel_items_product_id', fromTable: 'order_items', fromCol: 'product_id', toTable: 'products', toCol: 'id' }
      ];
      notes = [{ id: 'note1', text: 'Double click table to edit fields. Drag to re-arrange.', x: 50, y: 50 }];
      groupBoxes = [{ id: 'group1', name: 'Checkout Operations', color: 'rgba(0, 112, 243, 0.05)', x: 275, y: 100, w: 530, h: 250 }];
      render();
    }

    function loadLibraryTemplate() {
      tables = [
        { id: 'books', name: 'books', x: 50, y: 100, columns: [{ name: 'id', type: 'INT', isPK: true, isFK: false }, { name: 'title', type: 'VARCHAR(255)', isPK: false, isFK: false }, { name: 'author', type: 'VARCHAR(150)', isPK: false, isFK: false }] },
        { id: 'students', name: 'students', x: 50, y: 300, columns: [{ name: 'roll_no', type: 'VARCHAR(50)', isPK: true, isFK: false }, { name: 'name', type: 'VARCHAR(100)', isPK: false, isFK: false }, { name: 'department', type: 'VARCHAR(50)', isPK: false, isFK: false }] },
        { id: 'issue_records', name: 'issue_records', x: 350, y: 200, columns: [{ name: 'issue_id', type: 'INT', isPK: true, isFK: false }, { name: 'book_id', type: 'INT', isPK: false, isFK: true }, { name: 'student_roll', type: 'VARCHAR(50)', isPK: false, isFK: true }, { name: 'issue_date', type: 'DATE', isPK: false, isFK: false }] }
      ];
      relationships = [
        { id: 'r1', fromTable: 'issue_records', fromCol: 'book_id', toTable: 'books', toCol: 'id' },
        { id: 'r2', fromTable: 'issue_records', fromCol: 'student_roll', toTable: 'students', toCol: 'roll_no' }
      ];
      notes = [];
      groupBoxes = [];
      render();
    }

    function loadHostelTemplate() {
      tables = [
        { id: 'rooms', name: 'rooms', x: 50, y: 200, columns: [{ name: 'room_number', type: 'INT', isPK: true, isFK: false }, { name: 'capacity', type: 'INT', isPK: false, isFK: false }, { name: 'block_letter', type: 'CHAR(1)', isPK: false, isFK: false }] },
        { id: 'hostellers', name: 'hostellers', x: 320, y: 100, columns: [{ name: 'id', type: 'INT', isPK: true, isFK: false }, { name: 'name', type: 'VARCHAR(100)', isPK: false, isFK: false }, { name: 'room_no', type: 'INT', isPK: false, isFK: true }] },
        { id: 'attendance_logs', name: 'attendance_logs', x: 580, y: 100, columns: [{ name: 'log_id', type: 'INT', isPK: true, isFK: false }, { name: 'student_id', type: 'INT', isPK: false, isFK: true }, { name: 'present_status', type: 'BOOLEAN', isPK: false, isFK: false }, { name: 'log_date', type: 'DATE', isPK: false, isFK: false }] }
      ];
      relationships = [
        { id: 'rh1', fromTable: 'hostellers', fromCol: 'room_no', toTable: 'rooms', toCol: 'room_number' },
        { id: 'rh2', fromTable: 'attendance_logs', fromCol: 'student_id', toTable: 'hostellers', toCol: 'id' }
      ];
      notes = [];
      groupBoxes = [];
      render();
    }

    // --- SQL DDL SCHEMA PARSER ---
    document.getElementById('btn-import-sql')?.addEventListener('click', () => {
      const sqlInput = (document.getElementById('sql-import-input') as HTMLTextAreaElement).value.trim();
      if (!sqlInput) {
        alert('Please paste some CREATE TABLE SQL code first!');
        return;
      }
      
      try {
        const parsed = parseSQL(sqlInput);
        if (parsed.tables.length === 0) {
          alert('Could not find any CREATE TABLE structures in the SQL code. Make sure queries are valid.');
          return;
        }
        
        tables = [...tables, ...parsed.tables];
        relationships = [...relationships, ...parsed.relationships];
        render();
      } catch (err) {
        alert('Error parsing SQL: ' + err);
      }
    });

    function parseSQL(sql: string) {
      const cleanSql = sql
        .replace(/\/\*[\s\S]*?\*\//g, '')
        .replace(/--.*$/gm, '')
        .replace(/\n/g, ' ')
        .replace(/\s+/g, ' ');

      const createTableRegex = /CREATE\s+TABLE\s+(\w+)\s*\(([^)]+)\)/gi;
      let match;
      const parsedTables: Table[] = [];
      const parsedRels: Relationship[] = [];

      while ((match = createTableRegex.exec(cleanSql)) !== null) {
        const tName = match[1];
        const body = match[2];

        const table: Table = {
          id: tName,
          name: tName,
          x: 100 + (parsedTables.length % 3) * 260,
          y: 80 + Math.floor(parsedTables.length / 3) * 200,
          columns: []
        };

        // Split by commas ignoring parentheses commas
        const tokens: string[] = [];
        let curr = "";
        let parens = 0;
        for (let char of body) {
          if (char === '(') parens++;
          if (char === ')') parens--;
          if (char === ',' && parens === 0) {
            tokens.push(curr.trim());
            curr = "";
          } else {
            curr += char;
          }
        }
        if (curr.trim()) tokens.push(curr.trim());

        tokens.forEach(tok => {
          const fkMatch = /FOREIGN\s+KEY\s*\((\w+)\)\s*REFERENCES\s*(\w+)\s*\((\w+)\)/i.exec(tok);
          const pkConstraintMatch = /PRIMARY\s+KEY\s*\((\w+)\)/i.exec(tok);

          if (fkMatch) {
            parsedRels.push({
              id: `rel_${tName}_${fkMatch[1]}`,
              fromTable: tName,
              fromCol: fkMatch[1],
              toTable: fkMatch[2],
              toCol: fkMatch[3]
            });
          } else if (pkConstraintMatch) {
            const col = table.columns.find(c => c.name === pkConstraintMatch[1]);
            if (col) col.isPK = true;
          } else if (!/^(PRIMARY KEY|FOREIGN KEY|CONSTRAINT|KEY)/i.test(tok)) {
            const parts = tok.split(/\s+/);
            const colName = parts[0];
            const colType = parts[1] || 'VARCHAR';
            const isPK = tok.toUpperCase().includes('PRIMARY KEY');

            table.columns.push({
              name: colName,
              type: colType.replace(/,/g, ''),
              isPK,
              isFK: false
            });
          }
        });

        parsedTables.push(table);
      }

      parsedRels.forEach(rel => {
        const tbl = parsedTables.find(t => t.id === rel.fromTable);
        if (tbl) {
          const col = tbl.columns.find(c => c.name === rel.fromCol);
          if (col) col.isFK = true;
        }
      });

      return { tables: parsedTables, relationships: parsedRels };
    }

    // --- MANUAL BUILDERS ---
    document.getElementById('btn-create-table')?.addEventListener('click', () => {
      const id = `table_${Date.now()}`;
      tables.push({
        id,
        name: `new_table_${tables.length + 1}`,
        x: 100,
        y: 100,
        columns: [{ name: 'id', type: 'INT', isPK: true, isFK: false }]
      });
      selectedTableId = id;
      updateSidebar();
      render();
    });

    document.getElementById('btn-add-note')?.addEventListener('click', () => {
      notes.push({
        id: `note_${Date.now()}`,
        text: 'New Sticky Note. Click to edit.',
        x: 150,
        y: 150
      });
      render();
    });

    document.getElementById('btn-add-group')?.addEventListener('click', () => {
      groupBoxes.push({
        id: `group_${Date.now()}`,
        name: 'New Area Block',
        color: 'rgba(0, 162, 255, 0.05)',
        x: 200,
        y: 200,
        w: 220,
        h: 180
      });
      render();
    });

    // --- INTERACTIVE DRAWING ---
    function render() {
      // Clear SVG layers
      svgGroupsLayer.innerHTML = '';
      svgLinesLayer.innerHTML = '';
      svgTablesLayer.innerHTML = '';
      svgNotesLayer.innerHTML = '';

      // Draw Group Boxes
      groupBoxes.forEach(group => {
        const isSelected = selectedGroupId === group.id;
        const g = document.createElementNS('http://www.w3.org/2000/svg', 'g');
        g.setAttribute('class', 'group-box');
        g.innerHTML = `
          <rect x="${group.x}" y="${group.y}" width="${group.w}" height="${group.h}" fill="${group.color}" stroke="${isSelected ? '#0070f3' : '#333333'}" stroke-width="${isSelected ? 2 : 1}" stroke-dasharray="4" rx="4" />
          <text x="${group.x + 8}" y="${group.y + 18}" fill="#888888" font-size="10" font-family="font-mono, monospace" font-weight="bold">${group.name.toUpperCase()}</text>
          <circle cx="${group.x + group.w}" cy="${group.y + group.h}" r="6" fill="#0070f3" class="group-resizer cursor-se-resize" data-group-id="${group.id}" />
        `;
        
        // Group dragging trigger
        g.querySelector('rect')?.addEventListener('mousedown', (e) => {
          e.stopPropagation();
          selectedGroupId = group.id;
          selectedTableId = null;
          selectedNoteId = null;
          updateSidebar();
          const rect = canvasSvg.getBoundingClientRect();
          dragElement = {
            type: 'group',
            id: group.id,
            offsetX: e.clientX - rect.left - group.x,
            offsetY: e.clientY - rect.top - group.y
          };
        });

        // Group resizing trigger
        g.querySelector('.group-resizer')?.addEventListener('mousedown', (e: any) => {
          e.stopPropagation();
          e.preventDefault();
          const rect = canvasSvg.getBoundingClientRect();
          dragElement = {
            type: 'group-resize',
            id: group.id,
            offsetX: e.clientX - rect.left - group.w,
            offsetY: e.clientY - rect.top - group.h
          };
        });

        // Double click to edit name
        g.addEventListener('dblclick', () => {
          const val = prompt('Edit group name:', group.name);
          if (val) {
            group.name = val;
            render();
          }
        });

        svgGroupsLayer.appendChild(g);
      });

      // Draw Tables
      tables.forEach(table => {
        const isSelected = selectedTableId === table.id;
        const colH = 18;
        const headerH = 28;
        const tableW = 200;
        const tableH = headerH + (table.columns.length * colH) + 6;

        const g = document.createElementNS('http://www.w3.org/2000/svg', 'g');
        g.setAttribute('transform', `translate(${table.x}, ${table.y})`);
        
        // Outer card body
        let innerHTML = `
          <rect width="${tableW}" height="${tableH}" fill="#0a0a0a" stroke="${isSelected ? '#0070f3' : '#1e1e1e'}" stroke-width="${isSelected ? 2 : 1.5}" rx="8" class="table-card-bg" />
          <path d="M 0 28 L 200 28" stroke="${isSelected ? '#0070f3' : '#1e1e1e'}" stroke-width="1.5" />
          
          <!-- Table Header text -->
          <rect width="${tableW}" height="28" fill="transparent" class="table-header-handle cursor-grab" />
          <text x="12" y="18" fill="#ffffff" font-size="11" font-family="font-mono, monospace" font-weight="bold">${table.name}</text>
        `;

        // Columns text rows
        table.columns.forEach((col, idx) => {
          const y = headerH + (idx * colH) + 14;
          
          let icon = '';
          if (col.isPK) icon = '🔑 ';
          else if (col.isFK) icon = '🔗 ';

          innerHTML += `
            <text x="12" y="${y}" fill="${col.isPK ? '#00a2ff' : '#888888'}" font-size="10" font-family="sans-serif">${icon}${col.name}</text>
            <text x="${tableW - 12}" y="${y}" fill="#555555" font-size="9" font-family="font-mono, monospace" text-anchor="end">${col.type}</text>
          `;
        });

        g.innerHTML = innerHTML;

        // Mouse Events
        const headerHandle = g.querySelector('.table-header-handle')!;
        headerHandle.addEventListener('mousedown', (e: any) => {
          e.stopPropagation();
          selectedTableId = table.id;
          selectedNoteId = null;
          selectedGroupId = null;
          updateSidebar();
          const rect = canvasSvg.getBoundingClientRect();
          dragElement = {
            type: 'table',
            id: table.id,
            offsetX: e.clientX - rect.left - table.x,
            offsetY: e.clientY - rect.top - table.y
          };
          render();
        });

        // Double click to edit title
        g.addEventListener('dblclick', () => {
          const val = prompt('Edit Table Name:', table.name);
          if (val) {
            // Update table name and relationships dependencies
            const oldId = table.id;
            const cleanVal = val.trim().replace(/\s+/g, '_').toLowerCase();
            table.name = cleanVal;
            table.id = cleanVal;
            relationships.forEach(rel => {
              if (rel.fromTable === oldId) rel.fromTable = cleanVal;
              if (rel.toTable === oldId) rel.toTable = cleanVal;
            });
            selectedTableId = cleanVal;
            updateSidebar();
            render();
          }
        });

        svgTablesLayer.appendChild(g);
      });

      // Draw Relationship Lines
      relationships.forEach(rel => {
        const from = tables.find(t => t.id === rel.fromTable);
        const to = tables.find(t => t.id === rel.toTable);
        
        if (from && to) {
          const colH = 18;
          const headerH = 28;
          
          // Index offsets for specific columns
          const fromColIdx = from.columns.findIndex(c => c.name === rel.fromCol);
          const toColIdx = to.columns.findIndex(c => c.name === rel.toCol);
          
          const y1 = from.y + headerH + (fromColIdx >= 0 ? fromColIdx * colH : 0) + 10;
          const y2 = to.y + headerH + (toColIdx >= 0 ? toColIdx * colH : 0) + 10;

          // Align to sides of cards based on horizontal positions
          const x1 = from.x < to.x ? from.x + 200 : from.x;
          const x2 = from.x < to.x ? to.x : to.x + 200;

          // Bezier control coordinates
          const dx = Math.abs(x2 - x1) * 0.5;
          const cx1 = from.x < to.x ? x1 + dx : x1 - dx;
          const cx2 = from.x < to.x ? x2 - dx : x2 + dx;

          const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
          path.setAttribute('d', `M ${x1} ${y1} C ${cx1} ${y1}, ${cx2} ${y2}, ${x2} ${y2}`);
          path.setAttribute('fill', 'none');
          path.setAttribute('stroke', '#0070f3');
          path.setAttribute('stroke-width', '1.5');
          path.setAttribute('marker-end', 'url(#arrow)'); // connector marker arrow

          svgLinesLayer.appendChild(path);
        }
      });

      // Draw Sticky Notes
      notes.forEach(note => {
        const isSelected = selectedNoteId === note.id;
        const g = document.createElementNS('http://www.w3.org/2000/svg', 'g');
        g.setAttribute('transform', `translate(${note.x}, ${note.y})`);
        g.innerHTML = `
          <rect width="130" height="70" fill="rgba(245, 166, 35, 0.1)" stroke="${isSelected ? '#f5a623' : '#554422'}" stroke-width="${isSelected ? 2 : 1}" rx="4" />
          <foreignObject x="6" y="6" width="118" height="58">
            <div style="font-family:sans-serif; font-size:10px; color:#c5a666; word-wrap:break-word; max-height:58px; overflow:hidden;">${note.text}</div>
          </foreignObject>
        `;

        g.addEventListener('mousedown', (e: any) => {
          e.stopPropagation();
          selectedNoteId = note.id;
          selectedTableId = null;
          selectedGroupId = null;
          updateSidebar();
          const rect = canvasSvg.getBoundingClientRect();
          dragElement = {
            type: 'note',
            id: note.id,
            offsetX: e.clientX - rect.left - note.x,
            offsetY: e.clientY - rect.top - note.y
          };
          render();
        });

        g.addEventListener('dblclick', () => {
          const val = prompt('Edit note text:', note.text);
          if (val) {
            note.text = val;
            render();
          }
        });

        svgNotesLayer.appendChild(g);
      });
    }

    // --- MOUSE CANVAS INTERACTION ---
    canvasSvg.addEventListener('mousemove', (e: any) => {
      if (dragElement) {
        const rect = canvasSvg.getBoundingClientRect();
        const mouseX = e.clientX - rect.left;
        const mouseY = e.clientY - rect.top;

        if (dragElement.type === 'table') {
          const table = tables.find(t => t.id === dragElement!.id);
          if (table) {
            table.x = mouseX - dragElement.offsetX;
            table.y = mouseY - dragElement.offsetY;
          }
        } else if (dragElement.type === 'note') {
          const note = notes.find(n => n.id === dragElement!.id);
          if (note) {
            note.x = mouseX - dragElement.offsetX;
            note.y = mouseY - dragElement.offsetY;
          }
        } else if (dragElement.type === 'group') {
          const group = groupBoxes.find(g => g.id === dragElement!.id);
          if (group) {
            group.x = mouseX - dragElement.offsetX;
            group.y = mouseY - dragElement.offsetY;
          }
        } else if (dragElement.type === 'group-resize') {
          const group = groupBoxes.find(g => g.id === dragElement!.id);
          if (group) {
            group.w = Math.max(80, mouseX - dragElement.offsetX);
            group.h = Math.max(60, mouseY - dragElement.offsetY);
          }
        }
        render();
      }
    });

    window.addEventListener('mouseup', () => {
      dragElement = null;
    });

    // --- SIDEBAR EDITOR CONFIGS ---
    const tablePanel = document.getElementById('table-editor-panel')!;
    const editTableTitle = document.getElementById('edit-table-title')!;
    const columnListFields = document.getElementById('column-list-fields')!;

    function updateSidebar() {
      if (selectedTableId) {
        const table = tables.find(t => t.id === selectedTableId);
        if (table) {
          tablePanel.classList.remove('hidden');
          editTableTitle.textContent = table.name;
          
          columnListFields.innerHTML = table.columns.map((col, idx) => `
            <div class="p-2.5 rounded border border-brand-border bg-brand-black space-y-1.5 text-[10px]" data-col-idx="${idx}">
              <div class="flex items-center gap-1.5">
                <input 
                  type="text" 
                  value="${col.name}" 
                  class="bg-brand-gray-dark border border-brand-border rounded px-1.5 py-0.5 text-white font-mono flex-1 focus:outline-none col-name-input"
                  placeholder="name"
                />
                <button class="btn-del-col text-red-400 hover:text-red-600 font-mono">[x]</button>
              </div>
              <div class="flex items-center gap-2">
                <input 
                  type="text" 
                  value="${col.type}" 
                  class="bg-brand-gray-dark border border-brand-border rounded px-1.5 py-0.5 text-white font-mono w-24 focus:outline-none col-type-input"
                  placeholder="VARCHAR(50)"
                />
                <label class="flex items-center gap-1 cursor-pointer">
                  <input type="checkbox" ${col.isPK ? 'checked' : ''} class="col-pk-checkbox" /> PK
                </label>
                <label class="flex items-center gap-1 cursor-pointer">
                  <input type="checkbox" ${col.isFK ? 'checked' : ''} class="col-fk-checkbox" /> FK
                </label>
              </div>
            </div>
          `).join('');

          // Hook listeners inside column list inputs
          columnListFields.querySelectorAll('[data-col-idx]').forEach(el => {
            const idx = parseInt(el.getAttribute('data-col-idx') || '0');
            const col = table.columns[idx];

            const nameInput = el.querySelector('.col-name-input') as HTMLInputElement;
            nameInput.addEventListener('change', () => {
              col.name = nameInput.value.trim().toLowerCase();
              render();
            });

            const typeInput = el.querySelector('.col-type-input') as HTMLInputElement;
            typeInput.addEventListener('change', () => {
              col.type = typeInput.value.trim().toUpperCase();
              render();
            });

            const pkCheck = el.querySelector('.col-pk-checkbox') as HTMLInputElement;
            pkCheck.addEventListener('change', () => {
              col.isPK = pkCheck.checked;
              render();
            });

            const fkCheck = el.querySelector('.col-fk-checkbox') as HTMLInputElement;
            fkCheck.addEventListener('change', () => {
              col.isFK = fkCheck.checked;
              
              if (fkCheck.checked) {
                // Auto create connection request template
                const targetTable = prompt('Enter target table to reference:', 'users');
                const targetCol = prompt('Enter target column in that table:', 'id');
                if (targetTable && targetCol) {
                  relationships.push({
                    id: `rel_${table.id}_${col.name}`,
                    fromTable: table.id,
                    fromCol: col.name,
                    toTable: targetTable,
                    toCol: targetCol
                  });
                }
              } else {
                // Delete existing matching relationship
                relationships = relationships.filter(r => !(r.fromTable === table.id && r.fromCol === col.name));
              }
              render();
            });

            el.querySelector('.btn-del-col')?.addEventListener('click', () => {
              table.columns.splice(idx, 1);
              updateSidebar();
              render();
            });
          });
          return;
        }
      }

      tablePanel.classList.add('hidden');
    }

    document.getElementById('btn-add-col')?.addEventListener('click', () => {
      if (selectedTableId) {
        const table = tables.find(t => t.id === selectedTableId);
        if (table) {
          table.columns.push({ name: `new_col_${table.columns.length + 1}`, type: 'VARCHAR(50)', isPK: false, isFK: false });
          updateSidebar();
          render();
        }
      }
    });

    document.getElementById('btn-delete-table')?.addEventListener('click', () => {
      if (selectedTableId) {
        tables = tables.filter(t => t.id !== selectedTableId);
        relationships = relationships.filter(r => r.fromTable !== selectedTableId && r.toTable !== selectedTableId);
        selectedTableId = null;
        updateSidebar();
        render();
      }
    });

    // --- SQL EXPORTER ---
    document.getElementById('btn-export-sql')?.addEventListener('click', () => {
      let ddl = `-- SciCalcX Generated Database DDL schema\n\n`;
      
      tables.forEach(t => {
        ddl += `CREATE TABLE ${t.name} (\n`;
        const colLines = t.columns.map(c => {
          let line = `  ${c.name} ${c.type}`;
          if (c.isPK) line += ` PRIMARY KEY`;
          return line;
        });

        // Add foreign key constraint declarations
        relationships.filter(r => r.fromTable === t.id).forEach(r => {
          colLines.push(`  FOREIGN KEY (${r.fromCol}) REFERENCES ${r.toTable}(${r.toCol})`);
        });

        ddl += colLines.join(',\n');
        ddl += `\n);\n\n`;
      });

      // Output to standard clipboard download file
      const blob = new Blob([ddl], { type: 'text/sql' });
      const el = document.createElement('a');
      el.href = URL.createObjectURL(blob);
      el.download = 'schema.sql';
      el.click();
    });

    // --- JSON EXPORTER ---
    document.getElementById('btn-export-json')?.addEventListener('click', () => {
      const dataStr = JSON.stringify({ tables, relationships, notes, groupBoxes }, null, 2);
      const blob = new Blob([dataStr], { type: 'application/json' });
      const el = document.createElement('a');
      el.href = URL.createObjectURL(blob);
      el.download = 'schema.json';
      el.click();
    });

    // --- AUTO-ALIGN GRID ---
    document.getElementById('btn-auto-align')?.addEventListener('click', () => {
      tables.forEach((t, idx) => {
        t.x = 80 + (idx % 3) * 260;
        t.y = 80 + Math.floor(idx / 3) * 200;
      });
      render();
    });

    // --- VERSION HISTORY PERSISTENCE ---
    const historyList = document.getElementById('history-states-list')!;
    
    function saveHistoryState() {
      const state = {
        timestamp: new Date().toLocaleTimeString(),
        tables,
        relationships,
        notes,
        groupBoxes
      };
      
      const saved = JSON.parse(localStorage.getItem('scicalcx_erd_history') || '[]');
      saved.unshift(state);
      localStorage.setItem('scicalcx_erd_history', JSON.stringify(saved.slice(0, 10))); // Limit to 10
      renderHistoryList();
    }
    
    document.getElementById('btn-history-save')?.addEventListener('click', saveHistoryState);

    function renderHistoryList() {
      const saved = JSON.parse(localStorage.getItem('scicalcx_erd_history') || '[]');
      if (saved.length === 0) {
        historyList.innerHTML = `<div class="text-center py-2 text-brand-text-dim text-[9px]">No historical states saved.</div>`;
        return;
      }

      historyList.innerHTML = saved.map((s: any, idx: number) => `
        <div class="flex items-center justify-between p-1.5 border border-brand-border rounded bg-brand-black hover:bg-brand-gray-hover cursor-pointer" data-hist-idx="${idx}">
          <span>Save state (${s.timestamp})</span>
          <span class="text-brand-blue-neon text-[9px] hover:underline">[Load]</span>
        </div>
      `).join('');

      historyList.querySelectorAll('[data-hist-idx]').forEach(el => {
        el.addEventListener('click', () => {
          const idx = parseInt(el.getAttribute('data-hist-idx') || '0');
          const state = saved[idx];
          if (state) {
            tables = state.tables || [];
            relationships = state.relationships || [];
            notes = state.notes || [];
            groupBoxes = state.groupBoxes || [];
            selectedTableId = null;
            updateSidebar();
            render();
          }
        });
      });
    }

    // --- IMAGE SVG EXPORTER ---
    document.getElementById('btn-export-png')?.addEventListener('click', () => {
      // Export SVG content to file directly
      const svgData = new XMLSerializer().serializeToString(canvasSvg);
      const svgBlob = new Blob([svgData], { type: 'image/svg+xml;charset=utf-8' });
      const svgUrl = URL.createObjectURL(svgBlob);
      const downloadLink = document.createElement('a');
      downloadLink.href = svgUrl;
      downloadLink.download = 'database-diagram.svg';
      document.body.appendChild(downloadLink);
      downloadLink.click();
      document.body.removeChild(downloadLink);
    });

    // Initial Load
    loadEcommerceTemplate();
    renderHistoryList();
  </script>
</Layout>
