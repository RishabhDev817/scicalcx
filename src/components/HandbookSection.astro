---
import type { HandbookData } from '../i18n/content/handbooks';
import type { SupportedLanguage } from '../i18n/ui';
import { useTranslatedPath } from '../i18n/utils';

interface Props {
  handbook: HandbookData;
  lang?: SupportedLanguage;
}

const { handbook, lang = 'en' } = Astro.props;
const translatePath = useTranslatedPath(lang);
---

<section class="border border-brand-border bg-brand-gray-dark/20 rounded-xl p-6 sm:p-8 space-y-6 text-brand-text-muted leading-relaxed text-sm">
  <div class="border-b border-brand-border pb-3">
    <div class="text-[10px] font-mono uppercase tracking-widest text-brand-blue-neon mb-1">
      {handbook.badge}
    </div>
    <h2 class="text-lg font-bold tracking-tight text-white flex items-center gap-2">
      <span class="text-brand-blue-neon font-mono">#</span> {handbook.title}
    </h2>
  </div>

  <div class="space-y-6">
    {handbook.sections.map((sec) => (
      <div class="space-y-3">
        <h3 class="text-base font-semibold text-white tracking-tight">
          {sec.title}
        </h3>
        {sec.paragraphs.map((p) => (
          <p class="text-xs sm:text-sm text-brand-text-muted leading-relaxed">
            {p}
          </p>
        ))}
        {sec.formula && (
          <div class="bg-brand-black/50 border border-brand-border p-4 rounded-lg font-mono text-xs text-center text-brand-blue-neon overflow-x-auto my-2">
            {sec.formula}
          </div>
        )}
        {sec.note && (
          <div class="text-xs italic text-brand-text-dim border-l-2 border-brand-blue/50 pl-3">
            {sec.note}
          </div>
        )}
      </div>
    ))}
  </div>

  {handbook.recommendationTitle && (
    <div class="p-4 sm:p-5 rounded-xl border border-brand-border bg-brand-gray-light/60 backdrop-blur-sm flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 hover:border-brand-border-strong transition-colors duration-200">
      <div class="space-y-1">
        <div class="text-[10px] font-mono uppercase tracking-wider text-brand-blue-neon">
          Reference Resource
        </div>
        <h4 class="text-sm font-semibold text-white">
          {handbook.recommendationTitle}
        </h4>
        <p class="text-xs text-brand-text-muted">
          {handbook.recommendationDesc}
        </p>
      </div>
      <a
        href={translatePath(handbook.recommendationHref)}
        class="shrink-0 text-xs font-mono font-semibold px-4 py-2.5 rounded border border-brand-blue-neon/40 hover:border-brand-blue-neon bg-brand-blue/10 hover:bg-brand-blue text-brand-blue-neon hover:text-white transition-all duration-200"
      >
        {handbook.recommendationAction}
      </a>
    </div>
  )}
</section>
