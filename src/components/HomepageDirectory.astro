---
import { useTranslations, useTranslatedPath } from '../i18n/utils';
import type { SupportedLanguage } from '../i18n/ui';
import { directoryContent } from '../i18n/content/directoryContent';

interface Props {
  lang?: SupportedLanguage;
}

const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
const content = directoryContent[lang] || directoryContent.en;

const toolHrefs = [
  translatePath('/'),
  translatePath('/matrix'),
  translatePath('/calculus'),
  translatePath('/graphing'),
  translatePath('/statistics'),
  translatePath('/programming'),
  translatePath('/compiler'),
];
---

<div class="w-full space-y-12 pt-8">
  <!-- Core Tools Directory Grid -->
  <section class="space-y-6">
    <div class="border-b border-brand-border/60 pb-3 flex flex-col sm:flex-row sm:items-end justify-between gap-2">
      <div>
        <div class="text-[10px] font-mono uppercase tracking-widest text-brand-blue-neon">{t('nav.scientific')} · SciCalcX</div>
        <h2 class="text-2xl font-bold tracking-tight text-brand-text">{content.toolsTitle}</h2>
      </div>
      <p class="text-xs text-brand-text-muted font-mono">{content.toolsSubtitle}</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {content.tools.map((tool, index) => (
        <a 
          href={toolHrefs[index]}
          class="group p-5 rounded-xl border border-brand-border bg-brand-gray-dark/40 hover:bg-brand-gray-dark/70 hover:border-brand-blue/50 transition-all flex flex-col justify-between space-y-3"
        >
          <div class="space-y-2">
            <div class="flex items-center justify-between">
              <div class="flex items-center space-x-2.5">
                <span class="w-7 h-7 rounded-lg bg-brand-black border border-brand-border flex items-center justify-center font-mono font-bold text-xs text-brand-text group-hover:border-brand-blue/60 group-hover:text-brand-blue-neon transition-colors">
                  {tool.icon}
                </span>
                <h3 class="text-base font-semibold text-brand-text group-hover:text-white transition-colors">
                  {tool.title}
                </h3>
              </div>
              <span class={`text-[9px] font-mono px-2 py-0.5 rounded-full border ${tool.badgeColor}`}>
                {tool.badge}
              </span>
            </div>
            <p class="text-xs text-brand-text-muted leading-relaxed">
              {tool.desc}
            </p>
          </div>
          <div class="text-[11px] font-mono text-brand-blue flex items-center gap-1 group-hover:translate-x-0.5 transition-transform pt-1">
            {content.launchTool} <span>&rarr;</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- What is SciCalcX? (Comprehensive Architectural Overview) -->
  <section class="border border-brand-border bg-brand-gray-dark/30 rounded-2xl p-6 sm:p-8 space-y-6">
    <div class="space-y-2">
      <div class="text-[10px] font-mono uppercase tracking-widest text-brand-blue-neon">{content.aboutBadge}</div>
      <h2 class="text-2xl font-bold tracking-tight text-brand-text">{content.aboutTitle}</h2>
    </div>
    
    <div class="text-sm text-brand-text-muted leading-relaxed space-y-4">
      <p>
        <strong class="text-brand-text">SciCalcX</strong> {content.aboutP1}
      </p>
      <p>
        {content.aboutP2}
      </p>
      <p>
        {content.aboutP3}
      </p>
    </div>
  </section>

  <!-- Who Can Use SciCalcX? -->
  <section class="space-y-6">
    <div class="space-y-1">
      <div class="text-[10px] font-mono uppercase tracking-widest text-brand-blue-neon">{content.audiencesBadge}</div>
      <h2 class="text-2xl font-bold tracking-tight text-brand-text">{content.audiencesTitle}</h2>
      <p class="text-xs text-brand-text-muted">{content.audiencesSubtitle}</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      {content.audiences.map((aud) => (
        <div class="border border-brand-border bg-brand-gray-dark/40 rounded-xl p-5 space-y-2.5">
          <div class="text-2xl">{aud.icon}</div>
          <h3 class="text-sm font-semibold text-brand-text">{aud.title}</h3>
          <p class="text-xs text-brand-text-muted leading-relaxed">{aud.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- How SciCalcX Works (Execution Pipeline) -->
  <section class="border border-brand-border bg-brand-gray-dark/30 rounded-2xl p-6 sm:p-8 space-y-6">
    <div class="space-y-1">
      <div class="text-[10px] font-mono uppercase tracking-widest text-brand-blue-neon">{content.pipelineBadge}</div>
      <h2 class="text-2xl font-bold tracking-tight text-brand-text">{content.pipelineTitle}</h2>
      <p class="text-xs text-brand-text-muted">{content.pipelineSubtitle}</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 pt-2">
      {content.stages.map((st) => (
        <div class="border border-brand-border bg-brand-black/60 rounded-xl p-4 space-y-2">
          <div class="text-xs font-mono font-bold text-brand-blue-neon">{st.stage}</div>
          <h4 class="text-sm font-semibold text-brand-text">{st.title}</h4>
          <p class="text-xs text-brand-text-muted leading-relaxed">
            {st.desc}
          </p>
        </div>
      ))}
    </div>
  </section>

  <!-- Privacy Commitment & Educational Integrity -->
  <section class="border border-brand-border bg-brand-gray-dark/40 rounded-xl p-6 space-y-4">
    <div class="flex items-center space-x-2">
      <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
      <h3 class="text-sm font-semibold text-brand-text">{content.privacyTitle}</h3>
    </div>
    <p class="text-xs text-brand-text-muted leading-relaxed">
      {content.privacyText}
    </p>
    <div class="flex flex-wrap gap-4 pt-2 text-xs font-mono">
      <a href={translatePath('/privacy')} class="text-brand-blue hover:text-white transition-colors">{content.privacyLink} &rarr;</a>
      <a href={translatePath('/terms')} class="text-brand-blue hover:text-white transition-colors">{content.termsLink} &rarr;</a>
      <a href={translatePath('/editorial-integrity')} class="text-brand-blue hover:text-white transition-colors">{content.editorialLink} &rarr;</a>
    </div>
  </section>
</div>
