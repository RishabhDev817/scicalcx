---
import Layout from '../layouts/Layout.astro';
import type { SimulatorConfig } from '../data/simulators-registry';

interface Props {
  tool: SimulatorConfig;
}

const { tool } = Astro.props;

// Determine if we're rendering a high-precision measurement instrument
const isInstrument = tool.id === 'vernier-caliper' || tool.id === 'screw-gauge';
---

<Layout 
  activeTab="engineering-tools"
  title={`${tool.name} Simulator | SciCalcX`}
  description={tool.description}
>
  <!-- KaTeX for formula rendering -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.8/dist/katex.min.css" crossorigin="anonymous">
  <script is:inline src="https://cdn.jsdelivr.net/npm/katex@0.16.8/dist/katex.min.js" crossorigin="anonymous"></script>

  <div class="w-full max-w-5xl mx-auto space-y-6" data-tool-id={tool.id} data-is-instrument={String(isInstrument)}>
    <!-- Page Header -->
    <div class="space-y-3 border-b border-brand-border/60 pb-4">
      <div class="flex items-center justify-between">
        <a href="/engineering-tools" class="text-xs font-mono text-brand-blue-neon hover:underline flex items-center gap-1">
          &larr; Back to Engineering Hub
        </a>
        <div class="text-[10px] font-mono uppercase tracking-widest text-brand-text-muted">
          Simulator ID: {tool.id}
        </div>
      </div>
      
      <div class="flex items-center gap-3">
        <span class="text-3xl">{tool.emoji}</span>
        <div>
          <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-brand-text">
            {tool.name}<span class="text-brand-blue-neon">.</span>
          </h1>
          <p class="text-xs text-brand-text-muted mt-1">{tool.description}</p>
        </div>
      </div>
    </div>

    <!-- Mode Sub-Navigation Tabs -->
    <div class="border-b border-brand-border flex items-center space-x-2">
      <button 
        id="tab-simulate" 
        class="px-4 py-2 text-xs font-semibold border-b-2 border-brand-blue-neon text-white focus:outline-none transition-all cursor-pointer"
      >
        Simulate
      </button>
      <button 
        id="tab-explore" 
        class="px-4 py-2 text-xs font-semibold border-b-2 border-transparent text-brand-text-muted hover:text-white focus:outline-none transition-all cursor-pointer"
      >
        Explore Library
      </button>
      <button 
        id="tab-practice" 
        class="px-4 py-2 text-xs font-semibold border-b-2 border-transparent text-brand-text-muted hover:text-white focus:outline-none transition-all cursor-pointer"
      >
        Practice Mode
      </button>
      <button 
        id="tab-quiz" 
        class="px-4 py-2 text-xs font-semibold border-b-2 border-transparent text-brand-text-muted hover:text-white focus:outline-none transition-all cursor-pointer"
      >
        Timed Quiz
      </button>
    </div>

    <!-- Active Mode Visuals Layout -->
    <div id="workspace-layout" class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      
      <!-- LHS Controls / Settings Panel -->
      <div class="lg:col-span-1 space-y-4 flex flex-col justify-start">
        
        <!-- Simulate Settings -->
        <div id="settings-card-simulate" class="border border-brand-border bg-brand-gray-dark/40 rounded-xl p-5 space-y-4">
          <h2 class="text-xs font-semibold uppercase tracking-wider text-white font-mono border-b border-brand-border pb-2 flex items-center justify-between">
            <span>Instrument Settings</span>
            <span class="text-[9px] text-brand-blue-neon lowercase font-normal">[live parameters]</span>
          </h2>

          {isInstrument ? (
            <div class="space-y-4">
              <!-- System of Units Toggle -->
              <div class="space-y-1.5">
                <label class="text-[11px] text-brand-text-muted font-mono block">System of Units</label>
                <div class="grid grid-cols-2 gap-1 bg-brand-black p-1 rounded border border-brand-border/60">
                  <button id="unit-metric" class="py-1 text-[10px] font-mono font-semibold rounded bg-brand-gray-dark text-white cursor-pointer">Metric (mm)</button>
                  <button id="unit-imperial" class="py-1 text-[10px] font-mono font-semibold rounded text-brand-text-muted hover:text-white cursor-pointer">Imperial (in)</button>
                </div>
              </div>

              <!-- Least Count Toggle (Caliper Only) -->
              {tool.id === 'vernier-caliper' && (
                <div id="lc-pills-row" class="space-y-1.5">
                  <label class="text-[11px] text-brand-text-muted font-mono block">Least Count (Metric)</label>
                  <div class="grid grid-cols-3 gap-1 bg-brand-black p-1 rounded border border-brand-border/60">
                    <button data-lc-idx="0" class="py-1 text-[9px] font-mono rounded text-brand-text-muted hover:text-white cursor-pointer">0.1 mm</button>
                    <button data-lc-idx="1" class="py-1 text-[9px] font-mono rounded text-brand-text-muted hover:text-white cursor-pointer">0.05 mm</button>
                    <button data-lc-idx="2" class="py-1 text-[9px] font-mono rounded bg-brand-gray-dark text-brand-blue-neon font-bold cursor-pointer">0.02 mm</button>
                  </div>
                </div>
              )}

              <!-- Zero Error Switch & Stepper -->
              <div class="space-y-2 pt-2 border-t border-brand-border/60">
                <div class="flex items-center justify-between">
                  <label class="text-[11px] text-brand-text-muted font-mono">Zero Error Correction</label>
                  <button id="toggle-zero-error" class="px-2.5 py-1 text-[9px] font-mono rounded border border-brand-border bg-brand-black text-brand-text-muted hover:text-white cursor-pointer">
                    OFF
                  </button>
                </div>
                
                <div id="ze-stepper-container" class="hidden flex items-center justify-between bg-brand-black p-1.5 rounded border border-brand-border/60">
                  <button id="btn-ze-dec" class="px-3 py-1 bg-brand-gray-dark hover:bg-brand-border-hover text-white rounded text-xs cursor-pointer">-</button>
                  <span id="display-ze-divs" class="text-xs font-mono text-brand-blue-neon font-semibold">0 divs</span>
                  <button id="btn-ze-inc" class="px-3 py-1 bg-brand-gray-dark hover:bg-brand-border-hover text-white rounded text-xs cursor-pointer">+</button>
                </div>
              </div>
            </div>
          ) : (
            /* Fallback dynamic sliders for non-measuring simulators */
            <div class="space-y-4">
              {tool.inputs.map((inp) => (
                <div class="space-y-1.5">
                  <div class="flex items-center justify-between text-[11px]">
                    <label for={`input-${inp.id}`} class="text-brand-text-muted font-mono">{inp.name}</label>
                    <span id={`value-display-${inp.id}`} class="text-brand-blue-neon font-mono font-semibold">
                      {inp.default} {inp.unit}
                    </span>
                  </div>
                  
                  {inp.options ? (
                    <select 
                      id={`input-${inp.id}`} 
                      class="w-full bg-brand-black hover:border-brand-border-hover focus:border-brand-blue border border-brand-border rounded px-2.5 py-1.5 text-xs text-white focus:outline-none focus:ring-1 focus:ring-brand-blue/30"
                      data-input-id={inp.id}
                    >
                      {inp.options.map(opt => (
                        <option value={opt.value} selected={opt.value === inp.default}>{opt.label}</option>
                      ))}
                    </select>
                  ) : (
                    <input 
                      type="range" 
                      id={`input-${inp.id}`}
                      min={inp.min}
                      max={inp.max}
                      step={inp.step}
                      value={inp.default}
                      class="w-full h-1 bg-brand-border rounded-lg appearance-none cursor-pointer accent-brand-blue"
                      data-input-id={inp.id}
                    />
                  )}
                  <p class="text-[9px] text-brand-text-dim">{inp.description}</p>
                </div>
              ))}
            </div>
          )}
        </div>

        <!-- Practice & Quiz Screen Cards (shown only in those modes) -->
        <div id="settings-card-practice" class="hidden border border-brand-border bg-brand-gray-dark/40 rounded-xl p-5 space-y-4">
          <h2 class="text-xs font-semibold uppercase tracking-wider text-brand-blue-neon font-mono border-b border-brand-border pb-2">
            Practice Task
          </h2>
          <div class="space-y-3">
            <p class="text-xs text-slate-300 leading-relaxed">
              Read the scale below (taking any active Zero Error into account) and submit your reading:
            </p>
            <div id="practice-target-desc" class="p-3 bg-brand-black border border-brand-border/60 rounded text-center text-xs font-mono text-brand-text-muted">
              --
            </div>
            
            <div class="space-y-2">
              <input 
                type="number" 
                id="input-practice-guess" 
                step="0.01" 
                placeholder="Enter measurement..." 
                class="w-full bg-brand-black border border-brand-border rounded px-3 py-2 text-xs text-white placeholder-slate-600 focus:outline-none focus:border-brand-blue-neon"
              />
              <button id="btn-practice-submit" class="w-full py-2 bg-brand-blue-neon hover:bg-brand-blue text-slate-950 font-bold text-xs rounded transition-colors uppercase tracking-wider cursor-pointer">
                Submit Reading
              </button>
            </div>
            <div id="practice-feedback" class="hidden p-3 rounded text-center text-xs font-mono"></div>
          </div>
        </div>

        <div id="settings-card-quiz" class="hidden border border-brand-border bg-brand-gray-dark/40 rounded-xl p-5 space-y-4">
          <h2 class="text-xs font-semibold uppercase tracking-wider text-yellow-500 font-mono border-b border-brand-border pb-2">
            Timed Evaluation
          </h2>
          <div id="quiz-active-pane" class="space-y-4">
            <div class="flex justify-between items-center text-[10px] font-mono">
              <span id="quiz-question-counter" class="text-brand-text-muted">Question 1 of 5</span>
              <span id="quiz-timer" class="text-brand-blue-neon font-bold">120s</span>
            </div>
            <p class="text-xs text-white">Read the instrument display precisely. What is the value shown?</p>
            
            <div class="space-y-2">
              <input 
                type="number" 
                id="input-quiz-guess" 
                step="0.001" 
                placeholder="Enter reading..." 
                class="w-full bg-brand-black border border-brand-border rounded px-3 py-2 text-xs text-white focus:outline-none focus:border-brand-blue-neon"
              />
              <button id="btn-quiz-submit" class="w-full py-2 bg-yellow-500 hover:bg-yellow-600 text-slate-950 font-bold text-xs rounded transition-colors uppercase tracking-wider cursor-pointer font-mono text-[10px]">
                SUBMIT ANSWER
              </button>
            </div>
          </div>

          <div id="quiz-score-pane" class="hidden text-center py-6 space-y-3">
            <div class="text-3xl">🏁</div>
            <h3 class="text-sm font-bold text-white font-mono uppercase">Quiz Completed</h3>
            <p class="text-xs text-brand-text-muted">Your score: <span id="quiz-final-score" class="font-bold text-brand-blue-neon">0 / 5</span></p>
            <button id="btn-quiz-retry" class="px-4 py-2 border border-brand-border bg-brand-black hover:bg-brand-gray-hover text-xs rounded transition-colors text-white cursor-pointer font-mono">
              [ TRY AGAIN ]
            </button>
          </div>
        </div>

      </div>

      <!-- RHS Visualization & Computation Displays -->
      <div class="lg:col-span-2 space-y-4">
        
        <!-- Glowing LCD Readout Display -->
        {isInstrument && (
          <div class="border border-brand-border bg-brand-black rounded-xl p-4 flex items-center justify-between shadow-lg">
            <span class="text-xs font-mono uppercase text-brand-text-muted">Digital Readout:</span>
            <div id="digital-lcd-readout" class="text-3xl font-mono font-bold text-green-400 drop-shadow-[0_0_10px_rgba(34,197,94,0.4)] tracking-widest px-4 py-1.5 bg-green-950/20 border border-green-950/50 rounded-lg">
              0.00 mm
            </div>
          </div>
        )}

        <!-- 2D Canvas Simulator Frame -->
        {tool.hasVisual && (
          <div class="border border-brand-border bg-brand-black rounded-xl p-4 flex flex-col items-center justify-center relative overflow-hidden min-h-[400px]">
            <canvas 
              id="simulator-canvas" 
              width="1846" 
              height="714"
              class="w-full max-w-[923px] aspect-[1846/714] bg-transparent transition-transform duration-200"
            ></canvas>
            
            {isInstrument && (
              <button 
                id="btn-toggle-magnifier" 
                class="absolute bottom-3 right-3 px-3 py-1.5 text-[9px] font-mono border border-brand-border bg-brand-black hover:bg-brand-gray-hover text-brand-blue-neon rounded uppercase transition-colors cursor-pointer"
              >
                [ Toggle Zoom Magnifier ]
              </button>
            )}

            <div class="absolute bottom-2 left-3 text-[8px] font-mono text-brand-text-dim">
              [ 2D Simulation Engine &bull; Mouse Drag or Left/Right Arrows ]
            </div>
          </div>
        )}

        <!-- Dynamic Reading Step calculations -->
        {isInstrument && (
          <div class="border border-brand-border bg-brand-gray-dark/30 rounded-xl p-5 space-y-4">
            <h3 class="text-xs font-semibold uppercase tracking-wider text-brand-text-muted font-mono flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-brand-blue-neon animate-pulse"></span>
              Live Step-by-Step Measurement Math
            </h3>

            <!-- Formula display container -->
            <div class="bg-brand-black/40 border border-brand-border/60 p-4 rounded-lg space-y-4">
              <div id="formula-latex-math" class="text-center py-2 text-white font-mono text-sm">
                TR = MSR + (VSR &times; LC)
              </div>

              <!-- Mathematical breakdown steps columns -->
              <div class="grid grid-cols-1 sm:grid-cols-4 gap-3 text-xs font-mono pt-2 border-t border-brand-border/40">
                <div class="p-2.5 bg-brand-black/60 border border-brand-border/40 rounded flex flex-col justify-between">
                  <span class="text-[9px] text-brand-text-muted">1. MAIN SCALE (MSR)</span>
                  <span id="math-step-msr" class="text-xs font-bold text-white mt-1">0.00 mm</span>
                </div>
                <div class="p-2.5 bg-brand-black/60 border border-brand-border/40 rounded flex flex-col justify-between">
                  <span id="lbl-step-vsr" class="text-[9px] text-brand-text-muted">2. VERNIER (VSR)</span>
                  <span id="math-step-vsr" class="text-xs font-bold text-white mt-1">0 div</span>
                </div>
                <div class="p-2.5 bg-brand-black/60 border border-brand-border/40 rounded flex flex-col justify-between">
                  <span class="text-[9px] text-brand-text-muted">3. LEAST COUNT (LC)</span>
                  <span id="math-step-lc" class="text-xs font-bold text-white mt-1">0.02 mm</span>
                </div>
                <div class="p-2.5 bg-brand-black/60 border border-brand-border/40 rounded flex flex-col justify-between">
                  <span class="text-[9px] text-brand-text-muted">4. ZERO CORRECTION</span>
                  <span id="math-step-ze" class="text-xs font-bold text-white mt-1">0.00 mm</span>
                </div>
              </div>

              <div id="display-correction-formula" class="text-[10px] text-brand-text-muted font-mono pt-2">
                Corrected Reading = Observed (Obs) - Zero Error (ZE) = <span id="math-final-eval" class="text-brand-blue-neon font-bold">0.00 mm</span>
              </div>
            </div>
          </div>
        )}

        <!-- Output Tables for fallback tools -->
        {!isInstrument && (
          <div class="border border-brand-border bg-brand-gray-dark/30 rounded-xl p-5 space-y-3">
            <h3 class="text-xs font-semibold uppercase tracking-wider text-brand-text-muted font-mono flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-brand-blue-neon animate-pulse"></span>
              Real-time Computed Outputs
            </h3>
            
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2">
              {tool.outputs.map((out) => (
                <div class="flex items-center justify-between border-b border-brand-border/60 pb-1.5">
                  <span class="text-xs text-brand-text-muted font-mono">{out.name}</span>
                  <span id={`output-val-${out.id}`} class="text-sm font-semibold font-mono text-brand-text">
                    -- {out.unit}
                  </span>
                </div>
              ))}
            </div>

            <div class="pt-3 flex justify-end">
              <button id="btn-save-simulation" class="text-[9px] font-mono border border-brand-border bg-brand-black hover:bg-brand-gray-hover px-2.5 py-1 text-brand-blue-neon hover:text-white rounded uppercase transition-colors cursor-pointer">
                [ Save to calculations history ]
              </button>
            </div>
          </div>
        )}
      </div>
    </div>

    <!-- TAB 2: EXPLORE (Concept accordions and library) -->
    <div id="content-explore" class="hidden space-y-6">
      <div class="border border-brand-border bg-brand-gray-dark/20 rounded-xl p-6 sm:p-8 space-y-6">
        <h2 class="text-sm font-semibold uppercase tracking-wider text-white font-mono border-b border-brand-border pb-2">
          Governing Equations & Mechanics
        </h2>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {tool.formulas.map((form) => (
            <div class="p-4 rounded-lg border border-brand-border bg-brand-black/40 space-y-3">
              <div class="math-formula py-2 text-center text-white font-mono text-sm" data-latex={form.latex}>
                {form.latex}
              </div>
              <p class="text-xs text-brand-text-muted leading-relaxed">{form.explanation}</p>
            </div>
          ))}
        </div>

        <div class="space-y-3 prose prose-invert max-w-none text-xs text-brand-text-muted leading-relaxed">
          <div id="explore-markdown-rendered">
            <!-- Populated from exploreMarkdown in JS -->
          </div>
        </div>
      </div>
    </div>

    <!-- TAB 3: PRACTICE (Structured Tasks / Challenges) -->
    <div id="content-practice" class="hidden border border-brand-border bg-brand-gray-dark/20 rounded-xl p-6 sm:p-8 space-y-6">
      <h2 class="text-sm font-semibold uppercase tracking-wider text-white font-mono border-b border-brand-border pb-2">
        Practice Laboratory Tasks
      </h2>
      
      {tool.practiceTasks.length === 0 ? (
        <div class="text-center py-8 text-brand-text-muted text-xs font-mono">
          No practice challenges configured for this tool yet. Use the Simulate mode for free exploration.
        </div>
      ) : (
        <div class="space-y-4">
          {tool.practiceTasks.map((task, idx) => (
            <div class="p-4 rounded-lg border border-brand-border bg-brand-black/40 flex flex-col md:flex-row md:items-center justify-between gap-4">
              <div class="space-y-1">
                <div class="text-[10px] font-mono text-brand-blue-neon uppercase">Task #{idx + 1}</div>
                <div class="text-xs font-medium text-white">{task.question}</div>
                <div class="text-[10px] text-brand-text-dim">Hint: {task.hint}</div>
              </div>
              
              <div class="shrink-0 flex items-center gap-2">
                <span id={`practice-status-${idx}`} class="text-[10px] font-mono px-2 py-1 rounded bg-red-500/10 text-red-400 border border-red-500/20">
                  Not Met
                </span>
              </div>
            </div>
          ))}
        </div>
      )}
    </div>

    <!-- TAB 4: QUIZ (Interactive timed evaluation) -->
    <div id="content-quiz" class="hidden border border-brand-border bg-brand-gray-dark/20 rounded-xl p-6 sm:p-8 space-y-6">
      <h2 class="text-sm font-semibold uppercase tracking-wider text-white font-mono border-b border-brand-border pb-2">
        Randomized Concept Quiz
      </h2>
      
      {tool.quizQuestions.length === 0 ? (
        <div class="text-center py-8 text-brand-text-muted text-xs font-mono">
          No quiz questions configured for this tool yet.
        </div>
      ) : (
        <div id="quiz-container" class="space-y-4">
          <!-- Active Question Screen -->
          <div id="quiz-question-box" class="space-y-4">
            <div id="quiz-meta" class="text-[10px] font-mono text-brand-blue-neon uppercase font-bold">Question 1 of {tool.quizQuestions.length}</div>
            <div id="quiz-text" class="text-sm text-white font-medium">--</div>
            
            <div id="quiz-options-list" class="grid grid-cols-1 gap-2">
              <!-- Populated by script -->
            </div>
            
            <div id="quiz-feedback" class="hidden p-3 rounded text-xs leading-relaxed">
              <!-- Result statement -->
            </div>

            <div class="flex justify-end gap-2 pt-2">
              <button id="btn-quiz-submit-choice" class="text-xs px-4 py-2 rounded bg-brand-blue-neon text-slate-950 font-bold hover:bg-brand-blue transition-colors cursor-pointer">Submit</button>
              <button id="btn-quiz-next" class="hidden text-xs px-4 py-2 rounded border border-brand-border hover:bg-brand-gray-hover text-white transition-colors cursor-pointer font-mono text-[10px]">NEXT &rarr;</button>
            </div>
          </div>

          <!-- Score Summary Screen -->
          <div id="quiz-score-box" class="hidden text-center py-8 space-y-4">
            <div class="text-3xl">🎉</div>
            <h3 class="text-base font-bold text-white">Quiz Completed</h3>
            <p class="text-xs text-brand-text-muted">You scored <span id="quiz-concept-final-score" class="font-bold text-white font-mono">0</span> out of {tool.quizQuestions.length}.</p>
            <button id="btn-quiz-retry" class="text-xs border border-brand-border bg-brand-black hover:bg-brand-gray-hover px-4 py-2 rounded transition-colors text-white cursor-pointer font-mono">Retry Quiz</button>
          </div>
        </div>
      )}
    </div>

    <!-- Educational Guide Section (Bottom of Page) -->
    {isInstrument && (
      <section class="border-t border-brand-border/60 pt-10 space-y-6">
        <h2 class="text-lg font-bold tracking-tight text-white font-mono flex items-center gap-2">
          📖 High-Precision Metrology Guide
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-xs text-brand-text-muted leading-relaxed">
          <div class="space-y-3 bg-brand-gray-dark/10 p-5 rounded-xl border border-brand-border/40">
            <h3 class="font-bold text-brand-blue-neon font-mono uppercase">Vernier Caliper vs. Micrometer</h3>
            <div class="overflow-x-auto">
              <table class="w-full text-left border-collapse text-[10px]">
                <thead>
                  <tr class="border-b border-brand-border/60 text-white font-mono">
                    <th class="py-1">Feature</th>
                    <th class="py-1">Caliper</th>
                    <th class="py-1">Micrometer</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-brand-border/40 text-[10px]">
                  <tr>
                    <td class="py-1 text-white">Typical Least Count</td>
                    <td class="py-1">0.02 mm / 0.05 mm</td>
                    <td class="py-1 text-brand-blue-neon font-semibold">0.01 mm / 0.005 mm</td>
                  </tr>
                  <tr>
                    <td class="py-1 text-white">Measurement Range</td>
                    <td class="py-1 text-brand-blue-neon font-semibold">0 - 150 mm (large)</td>
                    <td class="py-1">0 - 25 mm (sub-ranges)</td>
                  </tr>
                  <tr>
                    <td class="py-1 text-white">Versatility</td>
                    <td class="py-1 text-brand-blue-neon font-semibold">Internal, External, Depth</td>
                    <td class="py-1">External Thickness only</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <div class="space-y-3 bg-brand-gray-dark/10 p-5 rounded-xl border border-brand-border/40">
            <h3 class="font-bold text-yellow-500 font-mono uppercase">Common Reading Mistakes</h3>
            <ul class="list-disc pl-4 space-y-1.5">
              <li>
                <strong class="text-white">Parallax Error:</strong> Looking at the alignment line from an angle rather than normal to the scale.
              </li>
              <li>
                <strong class="text-white">Ignoring Zero Error:</strong> Neglecting to calibrate or deduct the instrument offset before calculating the final reading.
              </li>
              <li>
                <strong class="text-white">Misjudging divisions:</strong> Counting VSD index lines incorrectly on the circular scale.
              </li>
            </ul>
          </div>
        </div>
      </section>
    )}
  </div>

  <script>
    import { SIMULATORS } from '../data/simulators-registry';

    const container = document.querySelector('[data-tool-id]') as HTMLElement;
    const toolId = container?.getAttribute('data-tool-id');
    const isInstrument = container?.getAttribute('data-is-instrument') === 'true';
    const tool = SIMULATORS.find(s => s.id === toolId);

    if (tool) {
      // Dynamic Web Audio API Synthesizer Context
      let audioCtx: AudioContext | null = null;

      function getAudioContext() {
        if (!audioCtx) {
          audioCtx = new (window.AudioContext || (window as any).webkitAudioContext)();
        }
        if (audioCtx.state === 'suspended') {
          audioCtx.resume();
        }
        return audioCtx;
      }

      function playTick() {
        try {
          const ctx = getAudioContext();
          const osc = ctx.createOscillator();
          const gain = ctx.createGain();
          osc.type = 'sine';
          osc.frequency.setValueAtTime(1200, ctx.currentTime);
          gain.gain.setValueAtTime(0.015, ctx.currentTime);
          gain.gain.exponentialRampToValueAtTime(0.0001, ctx.currentTime + 0.015);
          osc.connect(gain);
          gain.connect(ctx.destination);
          osc.start();
          osc.stop(ctx.currentTime + 0.015);
        } catch(e) {}
      }

      function playClick() {
        try {
          const ctx = getAudioContext();
          const osc = ctx.createOscillator();
          const gain = ctx.createGain();
          osc.type = 'triangle';
          osc.frequency.setValueAtTime(650, ctx.currentTime);
          gain.gain.setValueAtTime(0.04, ctx.currentTime);
          gain.gain.exponentialRampToValueAtTime(0.0001, ctx.currentTime + 0.03);
          osc.connect(gain);
          gain.connect(ctx.destination);
          osc.start();
          osc.stop(ctx.currentTime + 0.03);
        } catch(e) {}
      }

      function playChime(success: boolean) {
        try {
          const ctx = getAudioContext();
          const osc = ctx.createOscillator();
          const gain = ctx.createGain();
          osc.type = 'sine';
          osc.frequency.setValueAtTime(success ? 880 : 220, ctx.currentTime);
          if (success) {
            osc.frequency.exponentialRampToValueAtTime(1100, ctx.currentTime + 0.1);
          }
          gain.gain.setValueAtTime(0.08, ctx.currentTime);
          gain.gain.exponentialRampToValueAtTime(0.0001, ctx.currentTime + 0.25);
          osc.connect(gain);
          gain.connect(ctx.destination);
          osc.start();
          osc.stop(ctx.currentTime + 0.25);
        } catch(e) {}
      }

      // State tracking
      const inputVals: Record<string, number> = {};
      const inputsList = tool.inputs;

      // Instrument settings & variables
      let currentUnit = 'metric'; // metric | imperial
      let lcIndex = 2; // 0=0.1, 1=0.05, 2=0.02
      let zeroErrorActive = false;
      let zeroErrorDivs = 0;
      let zoomMagnifierActive = false;
      let currentMode = 'simulate'; // simulate | explore | practice | quiz

      // Initialize inputs list
      inputsList.forEach((inp) => {
        const el = document.getElementById(`input-${inp.id}`) as HTMLInputElement | HTMLSelectElement;
        if (el) {
          inputVals[inp.id] = parseFloat(el.value);
          el.addEventListener('input', (e) => {
            const target = e.target as HTMLInputElement | HTMLSelectElement;
            inputVals[inp.id] = parseFloat(target.value);
            const valDisplay = document.getElementById(`value-display-${inp.id}`);
            if (valDisplay) {
              valDisplay.textContent = `${target.value} ${inp.unit}`;
            }
            recalculate();
          });
        } else {
          inputVals[inp.id] = inp.default;
        }
      });

      // Canvas element
      const canvas = document.getElementById('simulator-canvas') as HTMLCanvasElement;
      let isDragging = false;
      let lastAudioTickIndex = 0;

      if (canvas && (tool as any).drag) {
        const getMousePos = (e: MouseEvent | TouchEvent) => {
          const rect = canvas.getBoundingClientRect();
          const clientX = 'touches' in e ? (e as TouchEvent).touches[0].clientX : (e as MouseEvent).clientX;
          const clientY = 'touches' in e ? (e as TouchEvent).touches[0].clientY : (e as MouseEvent).clientY;
          return {
            x: (clientX - rect.left) * (canvas.width / rect.width),
            y: (clientY - rect.top) * (canvas.height / rect.height)
          };
        };

        const handleStart = (e: MouseEvent | TouchEvent) => {
          if (currentMode === 'practice' || currentMode === 'quiz') return; // Jaws are locked in guess modes
          const pos = getMousePos(e);
          const didDrag = (tool as any).drag!(canvas, inputVals, pos.x, pos.y, true, false);
          if (didDrag) {
            isDragging = true;
            syncInputsToDOM();
            recalculate();
          }
        };

        const handleMove = (e: MouseEvent | TouchEvent) => {
          if (!isDragging) return;
          e.preventDefault();
          const pos = getMousePos(e);
          (tool as any).drag!(canvas, inputVals, pos.x, pos.y, false, false);
          syncInputsToDOM();
          recalculate();
        };

        const handleEnd = (e: MouseEvent | TouchEvent) => {
          if (!isDragging) return;
          isDragging = false;
          const pos = getMousePos(e);
          (tool as any).drag!(canvas, inputVals, pos.x, pos.y, false, true);
          syncInputsToDOM();
          recalculate();
        };

        canvas.addEventListener('mousedown', handleStart);
        canvas.addEventListener('mousemove', handleMove);
        window.addEventListener('mouseup', handleEnd);

        canvas.addEventListener('touchstart', handleStart, { passive: false });
        canvas.addEventListener('touchmove', handleMove, { passive: false });
        window.addEventListener('touchend', handleEnd);
      }

      // Keyboard arrow keys fine tuning
      window.addEventListener('keydown', (e) => {
        if (currentMode === 'practice' || currentMode === 'quiz') return;
        
        let delta = 0;
        if (e.key === 'ArrowLeft') delta = -1;
        if (e.key === 'ArrowRight') delta = 1;
        
        if (delta !== 0) {
          const lcs = [0.1, 0.05, 0.02];
          const lc = currentUnit === 'imperial' ? 0.001 * 25.4 : lcs[lcIndex];
          
          if (tool.id === 'vernier-caliper') {
            inputVals.position = Math.max(0, Math.min(100, inputVals.position + delta * lc));
          } else if (tool.id === 'screw-gauge') {
            inputVals.position = Math.max(0, Math.min(25, inputVals.position + delta * lc));
          }
          syncInputsToDOM();
          recalculate();
        }
      });

      // Synchronize input states with HTML forms
      function syncInputsToDOM() {
        inputsList.forEach((inp) => {
          const el = document.getElementById(`input-${inp.id}`) as HTMLInputElement | HTMLSelectElement;
          if (el) {
            el.value = String(inputVals[inp.id]);
            const valDisplay = document.getElementById(`value-display-${inp.id}`);
            if (valDisplay) {
              valDisplay.textContent = `${inputVals[inp.id]} ${inp.unit}`;
            }
          }
        });
      }

      // Live Recalculator
      function recalculate() {
        if (!tool) return;

        // Apply Custom Instrument Settings if measuring tool
        if (isInstrument) {
          inputVals.unit = currentUnit === 'imperial' ? 1 : 0;
          inputVals.lc = lcIndex;
          inputVals.zero_error = zeroErrorActive ? zeroErrorDivs : 0;
        }

        const computed: Record<string, number | string> = {};
        tool.outputs.forEach(out => {
          const val = out.calculate(inputVals);
          computed[out.id] = val;
          const el = document.getElementById(`output-val-${out.id}`);
          if (el) {
            el.textContent = `${val} ${out.unit}`;
          }
        });

        // Trigger Canvas render
        const canvas = document.getElementById('simulator-canvas') as HTMLCanvasElement;
        if (canvas && tool.draw) {
          const theme = document.documentElement.classList.contains('light') ? 'light' : 'dark';
          const ctx = canvas.getContext('2d')!;
          
          ctx.save();
          if (zoomMagnifierActive) {
            // Apply 2x zoom transform offset
            const shiftX = (inputVals.position || 0) * (tool.id === 'screw-gauge' ? 8 : 4);
            const pivotX = tool.id === 'screw-gauge' ? 210 + shiftX : 45 + 50 + shiftX;
            ctx.scale(1.8, 1.8);
            ctx.translate(-pivotX + canvas.width / 3.6, -canvas.height / 3.6);
          }
          tool.draw(canvas, inputVals, theme);
          ctx.restore();
        }

        // Play audio feedback ticks based on division alignments
        if (isInstrument) {
          const lcs = [0.1, 0.05, 0.02];
          const lcVal = currentUnit === 'imperial' ? 0.001 * 25.4 : lcs[lcIndex];
          const observedPos = inputVals.position + (zeroErrorActive ? zeroErrorDivs * lcVal : 0);
          const currentTickIndex = Math.round(observedPos / lcVal);
          
          if (currentTickIndex !== lastAudioTickIndex) {
            if (currentTickIndex % 10 === 0) {
              playClick();
            } else {
              playTick();
            }
            lastAudioTickIndex = currentTickIndex;
          }
        }

        // Upgraded Instrument step calculations
        updateInstrumentOutputs(computed);

        // Check Practice goals
        checkPracticeTasks(computed);
      }

      // Upgrade display breakdowns
      function updateInstrumentOutputs(computed: Record<string, number | string>) {
        const lcs = [0.1, 0.05, 0.02];
        const lc = currentUnit === 'imperial' ? 0.001 : lcs[lcIndex];
        const unitsStr = currentUnit === 'imperial' ? 'in' : 'mm';
        
        // LCD values
        const finalReading = parseFloat(String(computed.total_reading || '0'));
        const lcdEl = document.getElementById('digital-lcd-readout');
        if (lcdEl) {
          lcdEl.textContent = `${finalReading.toFixed(currentUnit === 'imperial' ? 3 : 2)} ${unitsStr}`;
        }

        // Steps values
        const positionVal = currentUnit === 'imperial' ? inputVals.position / 25.4 : inputVals.position;
        const zeOffset = zeroErrorActive ? zeroErrorDivs * lc : 0;
        const observed = positionVal + zeOffset;
        const msdVal = currentUnit === 'imperial' ? 0.025 : 1.0;
        const msr = Math.max(0, Math.floor(observed / msdVal) * msdVal);
        const vsr = Math.round((observed - msr) / lc);

        const stepMsr = document.getElementById('math-step-msr');
        const stepVsr = document.getElementById('math-step-vsr');
        const stepLc = document.getElementById('math-step-lc');
        const stepZe = document.getElementById('math-step-ze');
        const finalEval = document.getElementById('math-final-eval');

        if (stepMsr) {
          stepMsr.textContent = `${msr.toFixed(currentUnit === 'imperial' ? 3 : 1)} ${unitsStr}`;
        }
        if (stepVsr) {
          stepVsr.textContent = `${vsr} div`;
        }
        if (stepLc) {
          stepLc.textContent = `${lc} ${unitsStr}`;
        }
        if (stepZe) {
          stepZe.textContent = `${(zeroErrorDivs * lc).toFixed(currentUnit === 'imperial' ? 3 : 2)} ${unitsStr}`;
        }
        if (finalEval) {
          const obsStr = (msr + vsr * lc).toFixed(currentUnit === 'imperial' ? 3 : 2);
          const errorStr = (zeroErrorDivs * lc).toFixed(currentUnit === 'imperial' ? 3 : 2);
          finalEval.textContent = `${obsStr} - (${errorStr}) = ${finalReading.toFixed(currentUnit === 'imperial' ? 3 : 2)} ${unitsStr}`;
        }

        const lblStepVsr = document.getElementById('lbl-step-vsr');
        if (lblStepVsr) {
          lblStepVsr.textContent = tool.id === 'screw-gauge' ? '2. THIMBLE (CSR)' : '2. VERNIER (VSR)';
        }

        const formulaMathEl = document.getElementById('formula-latex-math');
        if (formulaMathEl) {
          formulaMathEl.innerHTML = tool.id === 'screw-gauge' 
            ? `TR = MSR + (CSR &times; LC) = ${msr.toFixed(currentUnit === 'imperial' ? 3 : 1)} + (${vsr} &times; ${lc})`
            : `TR = MSR + (VSR &times; LC) = ${msr.toFixed(currentUnit === 'imperial' ? 3 : 1)} + (${vsr} &times; ${lc})`;
        }
      }

      // Magnifier zoom click
      const btnToggleMag = document.getElementById('btn-toggle-magnifier');
      btnToggleMag?.addEventListener('click', () => {
        zoomMagnifierActive = !zoomMagnifierActive;
        btnToggleMag.classList.toggle('bg-brand-blue-neon');
        btnToggleMag.classList.toggle('text-slate-950');
        recalculate();
      });

      // Unit toggles
      const btnMetric = document.getElementById('unit-metric');
      const btnImperial = document.getElementById('unit-imperial');
      
      btnMetric?.addEventListener('click', () => {
        currentUnit = 'metric';
        btnMetric.classList.add('bg-brand-gray-dark', 'text-white');
        btnMetric.classList.remove('text-brand-text-muted');
        btnImperial?.classList.remove('bg-brand-gray-dark', 'text-white');
        btnImperial?.classList.add('text-brand-text-muted');
        recalculate();
      });

      btnImperial?.addEventListener('click', () => {
        currentUnit = 'imperial';
        btnImperial.classList.add('bg-brand-gray-dark', 'text-white');
        btnImperial.classList.remove('text-brand-text-muted');
        btnMetric?.classList.remove('bg-brand-gray-dark', 'text-white');
        btnMetric?.classList.add('text-brand-text-muted');
        recalculate();
      });

      // Least count selectors
      const lcButtons = document.querySelectorAll('#lc-pills-row button');
      lcButtons.forEach((btn: any) => {
        btn.addEventListener('click', () => {
          lcIndex = parseInt(btn.getAttribute('data-lc-idx') || '2');
          lcButtons.forEach((b: any) => {
            b.classList.remove('bg-brand-gray-dark', 'text-brand-blue-neon', 'font-bold');
            b.classList.add('text-brand-text-muted');
          });
          btn.classList.add('bg-brand-gray-dark', 'text-brand-blue-neon', 'font-bold');
          recalculate();
        });
      });

      // Zero error toggles
      const toggleZeBtn = document.getElementById('toggle-zero-error');
      const zeStepperContainer = document.getElementById('ze-stepper-container');
      const displayZeDivs = document.getElementById('display-ze-divs');

      toggleZeBtn?.addEventListener('click', () => {
        zeroErrorActive = !zeroErrorActive;
        if (zeroErrorActive) {
          toggleZeBtn.textContent = 'ON';
          toggleZeBtn.className = 'px-2.5 py-1 text-[9px] font-mono rounded border border-emerald-500/30 bg-emerald-950/20 text-emerald-400 font-bold';
          zeStepperContainer?.classList.remove('hidden');
        } else {
          toggleZeBtn.textContent = 'OFF';
          toggleZeBtn.className = 'px-2.5 py-1 text-[9px] font-mono rounded border border-brand-border bg-brand-black text-brand-text-muted hover:text-white';
          zeStepperContainer?.classList.add('hidden');
          zeroErrorDivs = 0;
          if (displayZeDivs) displayZeDivs.textContent = '0 divs';
        }
        recalculate();
      });

      document.getElementById('btn-ze-dec')?.addEventListener('click', () => {
        zeroErrorDivs = Math.max(-5, zeroErrorDivs - 1);
        if (displayZeDivs) displayZeDivs.textContent = `${zeroErrorDivs > 0 ? '+' : ''}${zeroErrorDivs} divs`;
        recalculate();
      });

      document.getElementById('btn-ze-inc')?.addEventListener('click', () => {
        zeroErrorDivs = Math.min(5, zeroErrorDivs + 1);
        if (displayZeDivs) displayZeDivs.textContent = `${zeroErrorDivs > 0 ? '+' : ''}${zeroErrorDivs} divs`;
        recalculate();
      });

      // Practice tasks verification
      function checkPracticeTasks(outputs: Record<string, number | string>) {
        if (!tool) return;
        tool.practiceTasks.forEach((task, idx) => {
          const statusEl = document.getElementById(`practice-status-${idx}`);
          if (!statusEl) return;

          let inputsMatch = true;
          Object.keys(task.targetInputValues).forEach(key => {
            if (inputVals[key] !== task.targetInputValues[key]) {
              inputsMatch = false;
            }
          });

          const outVal = parseFloat(String(outputs[task.targetOutputId]));
          const delta = Math.abs(outVal - task.targetValue);
          const outputsMatch = delta <= task.tolerance;

          if (inputsMatch && outputsMatch) {
            statusEl.textContent = 'Completed 🎉';
            statusEl.className = 'text-[10px] font-mono px-2 py-1 rounded bg-green-500/10 text-green-400 border border-green-500/20';
          } else {
            statusEl.textContent = 'Not Met';
            statusEl.className = 'text-[10px] font-mono px-2 py-1 rounded bg-red-500/10 text-red-400 border border-red-500/20';
          }
        });
      }

      // --- PRACTICE LAB WORKSPACE MODE ---
      let practiceTargetVal = 0;
      function generatePracticeChallenge() {
        const targetVal = 5 + Math.random() * 45;
        practiceTargetVal = targetVal;
        
        zeroErrorActive = Math.random() > 0.4;
        zeroErrorDivs = zeroErrorActive ? Math.floor(Math.random() * 11) - 5 : 0;
        
        inputVals.position = targetVal;

        const toggleZeBtn = document.getElementById('toggle-zero-error');
        const displayZeDivs = document.getElementById('display-ze-divs');
        if (toggleZeBtn) {
          if (zeroErrorActive) {
            toggleZeBtn.textContent = 'ON';
            toggleZeBtn.className = 'px-2.5 py-1 text-[9px] font-mono rounded border border-emerald-500/30 bg-emerald-950/20 text-emerald-400 font-bold';
            zeStepperContainer?.classList.remove('hidden');
          } else {
            toggleZeBtn.textContent = 'OFF';
            toggleZeBtn.className = 'px-2.5 py-1 text-[9px] font-mono rounded border border-brand-border bg-brand-black text-brand-text-muted hover:text-white';
            zeStepperContainer?.classList.add('hidden');
          }
        }
        if (displayZeDivs) {
          displayZeDivs.textContent = `${zeroErrorDivs > 0 ? '+' : ''}${zeroErrorDivs} divs`;
        }

        const desc = document.getElementById('practice-target-desc');
        if (desc) {
          desc.textContent = `Zero Error is active: calibrate reading accordingly.`;
        }
        const feedback = document.getElementById('practice-feedback');
        if (feedback) feedback.classList.add('hidden');

        recalculate();
      }

      document.getElementById('btn-practice-submit')?.addEventListener('click', () => {
        const guessEl = document.getElementById('input-practice-guess') as HTMLInputElement;
        const guess = parseFloat(guessEl.value || '0');
        const lcs = [0.1, 0.05, 0.02];
        const lc = currentUnit === 'imperial' ? 0.001 : lcs[lcIndex];
        const correctVal = tool.outputs[1].calculate(inputVals);

        const delta = Math.abs(guess - Number(correctVal));
        const isCorrect = delta <= lc * 1.5;

        const feedback = document.getElementById('practice-feedback');
        if (feedback) {
          feedback.classList.remove('hidden');
          if (isCorrect) {
            feedback.textContent = `Correct! Observed Reading is ${correctVal} ${currentUnit === 'imperial' ? 'in' : 'mm'}.`;
            feedback.className = 'p-3 rounded text-center text-xs font-mono bg-green-500/10 border border-green-500/20 text-green-400';
            playChime(true);
          } else {
            feedback.textContent = `Incorrect. Try again. Make sure to subtract Zero Error.`;
            feedback.className = 'p-3 rounded text-center text-xs font-mono bg-red-500/10 border border-red-500/20 text-red-400';
            playChime(false);
          }
        }
      });

      // --- TIMED QUIZ MODE ---
      let quizIndex = 0;
      let quizScore = 0;
      let quizQuestionsArr: { position: number; ze: number }[] = [];
      let quizTimerInterval: any = null;
      let quizTimeRemaining = 120;

      function startQuiz() {
        quizIndex = 0;
        quizScore = 0;
        quizTimeRemaining = 120;
        
        quizQuestionsArr = Array.from({ length: 5 }, () => ({
          position: 10 + Math.random() * 40,
          ze: Math.floor(Math.random() * 9) - 4
        }));

        document.getElementById('quiz-active-pane')?.classList.remove('hidden');
        document.getElementById('quiz-score-pane')?.classList.add('hidden');

        if (quizTimerInterval) clearInterval(quizTimerInterval);
        quizTimerInterval = setInterval(() => {
          quizTimeRemaining--;
          const timerEl = document.getElementById('quiz-timer');
          if (timerEl) timerEl.textContent = `${quizTimeRemaining}s`;
          if (quizTimeRemaining <= 0) {
            endQuiz();
          }
        }, 1000);

        loadQuizQuestion();
      }

      function loadQuizQuestion() {
        if (quizIndex >= 5) {
          endQuiz();
          return;
        }

        const q = quizQuestionsArr[quizIndex];
        inputVals.position = q.position;
        zeroErrorActive = q.ze !== 0;
        zeroErrorDivs = q.ze;

        const counterEl = document.getElementById('quiz-question-counter');
        if (counterEl) counterEl.textContent = `Question ${quizIndex + 1} of 5`;

        const guessEl = document.getElementById('input-quiz-guess') as HTMLInputElement;
        if (guessEl) guessEl.value = '';

        recalculate();
      }

      document.getElementById('btn-quiz-submit')?.addEventListener('click', () => {
        const guessEl = document.getElementById('input-quiz-guess') as HTMLInputElement;
        const guess = parseFloat(guessEl.value || '0');
        const lcs = [0.1, 0.05, 0.02];
        const lc = currentUnit === 'imperial' ? 0.001 : lcs[lcIndex];
        const correctVal = tool.outputs[1].calculate(inputVals);

        const delta = Math.abs(guess - Number(correctVal));
        const isCorrect = delta <= lc * 1.5;

        if (isCorrect) {
          quizScore++;
          playChime(true);
        } else {
          playChime(false);
        }

        quizIndex++;
        loadQuizQuestion();
      });

      function endQuiz() {
        if (quizTimerInterval) clearInterval(quizTimerInterval);
        document.getElementById('quiz-active-pane')?.classList.add('hidden');
        document.getElementById('quiz-score-pane')?.classList.remove('hidden');

        const scoreEl = document.getElementById('quiz-final-score');
        if (scoreEl) scoreEl.textContent = `${quizScore} / 5`;
      }

      document.getElementById('btn-quiz-retry')?.addEventListener('click', () => {
        startQuiz();
      });

      // Simple animation loop for real-time physics simulators
      let animationFrameId: number;
      function animationLoop() {
        recalculate();
        if (tool && tool.id === 'simple-pendulum') {
          animationFrameId = requestAnimationFrame(animationLoop);
        }
      }
      if (tool.id === 'simple-pendulum') {
        animationLoop();
      }

      // Initial Recalculation
      recalculate();

      // Hook up theme-changed events
      window.addEventListener('theme-changed', () => {
        recalculate();
      });

      // Save simulation handler
      const btnSaveSim = document.getElementById('btn-save-simulation');
      btnSaveSim?.addEventListener('click', () => {
        let expr = `${tool.name} Configuration: `;
        const inputsStr = tool.inputs.map(inp => `${inp.name}=${inputVals[inp.id]}${inp.unit}`).join(', ');
        expr += inputsStr;

        const mainOut = tool.outputs[0];
        const mainOutVal = mainOut.calculate(inputVals);
        const result = `${mainOut.name} = ${mainOutVal} ${mainOut.unit}`;

        window.dispatchEvent(
          new CustomEvent('add-history', {
            detail: { expr, result, mode: 'engineering-tools' }
          })
        );
      });

      // Tab selector triggers
      const tabs = ['simulate', 'explore', 'practice', 'quiz'];
      tabs.forEach(tab => {
        const btn = document.getElementById(`tab-${tab}`);
        btn?.addEventListener('click', () => {
          tabs.forEach(t => {
            document.getElementById(`tab-${t}`)?.classList.remove('border-brand-blue-neon', 'text-white');
            document.getElementById(`tab-${t}`)?.classList.add('border-transparent', 'text-brand-text-muted');
            
            const targetEl = document.getElementById(`content-${t}`);
            if (targetEl) targetEl.classList.add('hidden');
          });

          btn.classList.add('border-brand-blue-neon', 'text-white');
          btn.classList.remove('border-transparent', 'text-brand-text-muted');
          
          const contentEl = document.getElementById(`content-${tab}`);
          if (contentEl) contentEl.classList.remove('hidden');

          // Lock inputs sidebar card
          const settingsSimulate = document.getElementById('settings-card-simulate');
          const settingsPractice = document.getElementById('settings-card-practice');
          const settingsQuiz = document.getElementById('settings-card-quiz');
          
          settingsSimulate?.classList.add('hidden');
          settingsPractice?.classList.add('hidden');
          settingsQuiz?.classList.add('hidden');

          currentMode = tab;

          if (tab === 'simulate') {
            settingsSimulate?.classList.remove('hidden');
          } else if (tab === 'explore') {
            renderExploreContent();
          } else if (tab === 'practice') {
            settingsPractice?.classList.remove('hidden');
            generatePracticeChallenge();
          } else if (tab === 'quiz') {
            settingsQuiz?.classList.remove('hidden');
            startQuiz();
          }
        });
      });

      function renderMarkdownAndMath(text: string, targetEl: HTMLElement) {
        if (!text) return;
        let processed = text;
        
        const mathBlocks: { id: string; latex: string; display: boolean }[] = [];
        processed = processed.replace(/\$\$(.*?)\$\$/gs, (match, latex) => {
          const id = `math-block-${mathBlocks.length}-${Math.random().toString(36).substr(2, 5)}`;
          mathBlocks.push({ id, latex, display: true });
          return `<div id="${id}" class="my-3 text-center"></div>`;
        });

        const inlineMaths: { id: string; latex: string; display: boolean }[] = [];
        processed = processed.replace(/\$(.*?)\$/g, (match, latex) => {
          const id = `math-inline-${inlineMaths.length}-${Math.random().toString(36).substr(2, 5)}`;
          inlineMaths.push({ id, latex, display: false });
          return `<span id="${id}"></span>`;
        });

        processed = processed.replace(/###\s+(.*?)(?:\n|<br\/>|$)/g, '<h3 class="text-xs font-bold font-mono text-white mt-4 border-b border-brand-border/40 pb-1">$1</h3>');
        processed = processed.replace(/\*\*(.*?)\*\*/g, '<strong class="text-white font-semibold">$1</strong>');
        processed = processed.replace(/^\s*-\s+(.*?)(?:\n|<br\/>|$)/gm, '<li class="ml-4 list-disc">$1</li>');
        processed = processed.replace(/^\s*\d+\.\s+(.*?)(?:\n|<br\/>|$)/gm, '<li class="ml-4 list-decimal">$1</li>');

        targetEl.innerHTML = processed.split('\n').join('<br/>');

        if ((window as any).katex) {
          mathBlocks.forEach(item => {
            const el = document.getElementById(item.id);
            if (el) {
              (window as any).katex.render(item.latex, el, { throwOnError: false, displayMode: true });
            }
          });
          inlineMaths.forEach(item => {
            const el = document.getElementById(item.id);
            if (el) {
              (window as any).katex.render(item.latex, el, { throwOnError: false, displayMode: false });
            }
          });
        }
      }

      function renderExploreContent() {
        const target = document.getElementById('explore-markdown-rendered');
        if (target) {
          renderMarkdownAndMath(tool.exploreMarkdown, target);
        }

        if ((window as any).katex) {
          document.querySelectorAll('.math-formula').forEach((el: any) => {
            const latex = el.getAttribute('data-latex');
            if (latex) {
              (window as any).katex.render(latex, el, { throwOnError: false, displayMode: true });
            }
          });
        }
      }

      // Quiz Choice Selection Option Renderer
      let selectedOptionIdx: number | null = null;
      function loadQuestion() {
        selectedOptionIdx = null;
        const qFeedback = document.getElementById('quiz-feedback');
        const btnNext = document.getElementById('btn-quiz-next');
        const btnSubmitChoice = document.getElementById('btn-quiz-submit-choice');
        
        qFeedback?.classList.add('hidden');
        btnNext?.classList.add('hidden');
        btnSubmitChoice?.classList.remove('hidden');

        const q = tool.quizQuestions[quizIndex];
        const qText = document.getElementById('quiz-text');
        const qOptionsList = document.getElementById('quiz-options-list');

        if (qText) qText.textContent = q.question;
        if (qOptionsList) {
          qOptionsList.innerHTML = q.options.map((opt, oIdx) => `
            <button 
              class="quiz-option text-left p-3 rounded border border-brand-border bg-brand-black/20 hover:bg-brand-gray-hover/50 text-xs transition-colors focus:outline-none cursor-pointer"
              data-option-idx="${oIdx}"
            >
              ${opt}
            </button>
          `).join('');

          qOptionsList.querySelectorAll('.quiz-option').forEach(btn => {
            btn.addEventListener('click', (e) => {
              const target = e.currentTarget as HTMLButtonElement;
              selectedOptionIdx = parseInt(target.getAttribute('data-option-idx') || '0');

              qOptionsList.querySelectorAll('.quiz-option').forEach((el: any) => {
                el.classList.remove('border-brand-blue-neon');
                el.classList.add('border-brand-border');
              });
              target.classList.add('border-brand-blue-neon');
              target.classList.remove('border-brand-border');
            });
          });
        }
      }

      document.getElementById('btn-quiz-submit-choice')?.addEventListener('click', () => {
        if (selectedOptionIdx === null) return;
        const q = tool.quizQuestions[quizIndex];
        const correct = selectedOptionIdx === q.correctIndex;
        if (correct) quizScore++;

        const qFeedback = document.getElementById('quiz-feedback');
        if (qFeedback) {
          qFeedback.classList.remove('hidden');
          qFeedback.innerHTML = `
            <div class="${correct ? 'text-green-400 font-semibold' : 'text-red-400 font-semibold'}">
              ${correct ? '✓ Correct!' : '✗ Incorrect.'}
            </div>
            <div class="text-brand-text-muted mt-1">${q.explanation}</div>
          `;
          qFeedback.className = `p-3 rounded text-xs leading-relaxed ${correct ? 'bg-green-500/10 border border-green-500/20' : 'bg-red-500/10 border border-red-500/20'}`;
        }
        playChime(correct);

        document.getElementById('btn-quiz-submit-choice')?.classList.add('hidden');
        document.getElementById('btn-quiz-next')?.classList.remove('hidden');
      });

      document.getElementById('btn-quiz-next')?.addEventListener('click', () => {
        quizIndex++;
        if (quizIndex < tool.quizQuestions.length) {
          loadQuestion();
        } else {
          document.getElementById('quiz-question-box')?.classList.add('hidden');
          document.getElementById('quiz-score-box')?.classList.remove('hidden');
          const finalScore = document.getElementById('quiz-concept-final-score');
          if (finalScore) finalScore.textContent = `${quizScore}`;
        }
      });
    }
  </script>
</Layout>
