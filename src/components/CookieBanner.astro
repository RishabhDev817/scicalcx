---
// CookieBanner.astro
// Reusable cookie consent and ad disclosure banner for SciCalcX
import { useTranslatedPath } from '../i18n/utils';
import type { SupportedLanguage } from '../i18n/ui';

interface Props {
  lang?: SupportedLanguage;
}

const { lang = 'en' } = Astro.props;
const translatePath = useTranslatedPath(lang);

const cookieTranslations: Record<SupportedLanguage, {
  title: string;
  body: string;
  privacyLinkText: string;
  bodyAfter: string;
  learnMore: string;
  accept: string;
}> = {
  en: {
    title: 'Cookie & Privacy Notice',
    body: 'SciCalcX uses cookies and third-party vendor services (including Google AdSense) to serve personalized ads, analyze site traffic, and optimize performance. You can view our',
    privacyLinkText: 'Privacy Policy',
    bodyAfter: 'to learn more about our data handling and opt-out options.',
    learnMore: 'Learn More',
    accept: 'Accept & Continue',
  },
  es: {
    title: 'Aviso de Cookies y Privacidad',
    body: 'SciCalcX utiliza cookies y servicios de proveedores externos (incluido Google AdSense) para mostrar anuncios personalizados, analizar el tráfico y optimizar el rendimiento. Consulta nuestra',
    privacyLinkText: 'Política de Privacidad',
    bodyAfter: 'para conocer nuestras prácticas y opciones de exclusión.',
    learnMore: 'Más Información',
    accept: 'Aceptar y Continuar',
  },
  fr: {
    title: 'Avis de Confidentialité et Cookies',
    body: 'SciCalcX utilise des cookies et des services tiers (y compris Google AdSense) pour diffuser des annonces personnalisées, analyser le trafic et optimiser les performances. Consultez notre',
    privacyLinkText: 'Politique de Confidentialité',
    bodyAfter: 'pour en savoir plus sur la gestion de vos données.',
    learnMore: 'En Savoir Plus',
    accept: 'Accepter et Continuer',
  },
  de: {
    title: 'Cookie- & Datenschutzhinweis',
    body: 'SciCalcX verwendet Cookies und Drittanbieter-Dienste (einschließlich Google AdSense), um personalisierte Anzeigen bereitzustellen, den Datenverkehr zu analysieren und die Leistung zu optimieren. Weitere Informationen finden Sie in unserer',
    privacyLinkText: 'Datenschutzerklärung',
    bodyAfter: 'zu Datenverarbeitung und Deaktivierungsoptionen.',
    learnMore: 'Mehr Erfahren',
    accept: 'Akzeptieren & Fortfahren',
  },
  ja: {
    title: 'クッキーおよびプライバシーに関する通知',
    body: 'SciCalcXでは、パーソナライズ広告の配信、アクセス解析、パフォーマンス向上のためにクッキーおよび第三者サービス（Google AdSenseを含む）を使用しています。データの取り扱いおよびオプトアウトについては',
    privacyLinkText: 'プライバシーポリシー',
    bodyAfter: 'をご確認ください。',
    learnMore: '詳細を見る',
    accept: '同意して続行',
  },
  nl: {
    title: 'Cookie- en Privacyverklaring',
    body: 'SciCalcX maakt gebruik van cookies en diensten van derden (waaronder Google AdSense) om gepersonaliseerde advertenties weer te geven, verkeer te analyseren en prestaties te optimaliseren. Bekijk ons',
    privacyLinkText: 'Privacybeleid',
    bodyAfter: 'voor meer informatie over gegevensverwerking en afmeldopties.',
    learnMore: 'Meer informatie',
    accept: 'Accepteren & Doorgaan',
  },
  pt: {
    title: 'Aviso de Cookies e Privacidade',
    body: 'O SciCalcX utiliza cookies e serviços de terceiros (incluindo Google AdSense) para veicular anúncios personalizados, analisar o tráfego do site e otimizar o desempenho. Consulte a nossa',
    privacyLinkText: 'Política de Privacidade',
    bodyAfter: 'para saber mais sobre o tratamento de dados e opções de desativação.',
    learnMore: 'Saiba Mais',
    accept: 'Aceitar e Continuar',
  },
  ko: {
    title: '쿠키 및 개인정보 보호 안내',
    body: 'SciCalcX는 맞춤형 광고 게재, 사이트 트래픽 분석 및 성능 최적화를 위해 쿠키와 타사 서비스(Google AdSense 포함)를 사용합니다. 데이터 처리 방식 및 수신 거부 옵션에 대해 자세히 알아보려면',
    privacyLinkText: '개인정보 처리방침',
    bodyAfter: '을(를) 확인하세요.',
    learnMore: '자세히 보기',
    accept: '동의 및 계속하기',
  },
  it: {
    title: 'Informativa su Cookie e Privacy',
    body: 'SciCalcX utilizza cookie e servizi di fornitori terzi (incluso Google AdSense) per pubblicare annunci personalizzati, analizzare il traffico del sito e ottimizzare le prestazioni. Consulta la nostra',
    privacyLinkText: 'Informativa sulla Privacy',
    bodyAfter: 'per saperne di più sul trattamento dei dati e sulle opzioni di disattivazione.',
    learnMore: 'Ulteriori Informazioni',
    accept: 'Accetta e Continua',
  },
};

const c = cookieTranslations[lang] || cookieTranslations.en;
---

<div
  id="cookie-banner"
  class="fixed bottom-4 left-4 right-4 md:left-auto md:right-4 md:max-w-md bg-brand-gray-dark border border-brand-border rounded-xl p-4 shadow-2xl z-50 transform translate-y-full opacity-0 transition-all duration-300 ease-in-out font-sans text-xs"
  role="dialog"
  aria-live="polite"
  aria-label="Cookie and Privacy Preferences"
>
  <div class="flex flex-col gap-3">
    <div class="flex items-start justify-between gap-2 border-b border-brand-border/40 pb-2">
      <div class="flex items-center gap-2">
        <span class="text-brand-blue-neon font-mono text-[10px] uppercase font-bold tracking-wider">{c.title}</span>
      </div>
      <button
        id="cookie-close-btn"
        class="text-brand-text-dim hover:text-white transition-colors cursor-pointer text-sm font-mono p-0.5"
        aria-label="Close banner"
      >
        ✕
      </button>
    </div>

    <p class="text-brand-text-muted leading-relaxed text-[11px]">
      {c.body} <a href={translatePath('/privacy')} class="text-brand-blue-neon hover:underline">{c.privacyLinkText}</a> {c.bodyAfter}
    </p>

    <div class="flex items-center justify-end gap-2 pt-1 font-mono text-[11px]">
      <a
        href={translatePath('/privacy')}
        class="px-3 py-1.5 rounded border border-brand-border hover:border-brand-border-hover text-brand-text-muted hover:text-white transition-colors"
      >
        {c.learnMore}
      </a>
      <button
        id="cookie-accept-btn"
        class="px-4 py-1.5 rounded bg-brand-blue hover:bg-brand-blue-hover text-white font-semibold shadow-md transition-all cursor-pointer"
      >
        {c.accept}
      </button>
    </div>
  </div>
</div>

<script>
  (function () {
    const banner = document.getElementById('cookie-banner');
    const acceptBtn = document.getElementById('cookie-accept-btn');
    const closeBtn = document.getElementById('cookie-close-btn');

    if (!banner || !acceptBtn || !closeBtn) return;

    // Check if user has already acknowledged cookie consent
    const consent = localStorage.getItem('scicalcx_cookie_consent');

    if (!consent) {
      // Show banner after short delay
      setTimeout(() => {
        banner.classList.remove('translate-y-full', 'opacity-0');
      }, 1000);
    }

    function dismissBanner() {
      banner.classList.add('translate-y-full', 'opacity-0');
      localStorage.setItem('scicalcx_cookie_consent', 'acknowledged');
    }

    acceptBtn.addEventListener('click', dismissBanner);
    closeBtn.addEventListener('click', dismissBanner);
  })();
</script>
