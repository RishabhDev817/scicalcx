---
import Layout from '../../layouts/Layout.astro';
import { useTranslations } from '../../i18n/utils';
import type { SupportedLanguage } from '../../i18n/ui';
import { getFaqs } from '../../i18n/content/faq';
import { getHandbook } from '../../i18n/content/handbooks';
import FaqSection from '../FaqSection.astro';
import HandbookSection from '../HandbookSection.astro';
import CalculatorPedagogy from '../CalculatorPedagogy.astro';
import { getCalculatorPedagogy } from '../../data/calculatorData';

interface Props {
  lang?: SupportedLanguage;
}

const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);
const faqs = getFaqs('graphing', lang);
const handbook = getHandbook('graphing', lang);
const pedagogy = getCalculatorPedagogy('graphing', lang);

const faqHeadingMap: Record<SupportedLanguage, string> = {
  en: 'Frequently Asked Questions',
  es: 'Preguntas Frecuentes',
  ja: 'よくある質問（FAQ）',
  fr: 'Foire Aux Questions',
  de: 'Häufig gestellte Fragen',
  nl: 'Veelgestelde Vragen',
  pt: 'Perguntas Frequentes',
  ko: '자주 묻는 질문 (FAQ)',
  it: 'Domande Frequenti',
};
---

<Layout 
  activeTab="graphing" 
  lang={lang}
  title={t('meta.graphing.title')}
  description={t('meta.graphing.desc')}
  keywords={t('meta.graphing.keywords')}
>
  <div class="w-full max-w-6xl mx-auto space-y-6 flex flex-col h-full">
    <!-- Page Header -->
    <div class="text-center md:text-left space-y-1.5 border-b border-brand-border/60 pb-4">
      <div class="text-[10px] font-mono uppercase tracking-widest text-brand-blue-neon">
        {t('graphing.eyebrow')}
      </div>
      <h1 class="text-3xl font-bold tracking-tight text-brand-text">
        {t('graphing.heading')}<span class="text-brand-blue">.</span>
      </h1>
      <p class="text-xs text-brand-text-muted">
        {t('graphing.subheading')}
      </p>
      <div class="text-xs sm:text-sm text-brand-text-muted leading-relaxed space-y-2 pt-2 border-t border-brand-border/30">
        <p>
          {t('graphing.intro.p1')}
        </p>
        <p>
          {t('graphing.intro.p2')}
        </p>
      </div>
    </div>

    <!-- Layout Wrapper -->
    <div class="grid grid-cols-1 lg:grid-cols-4 gap-6 items-start">
      <!-- Left Controls Sidebar -->
      <div class="lg:col-span-1 space-y-4 border border-brand-border bg-brand-gray-dark/40 rounded-xl p-5 shadow-xl backdrop-blur-sm">
        <h2 class="text-xs font-semibold uppercase tracking-wider text-brand-text-muted flex items-center gap-1.5 border-b border-brand-border/40 pb-2">
          <span class="w-1.5 h-1.5 rounded-full bg-brand-blue-neon"></span>
          Function Inputs
        </h2>
        
        <div class="space-y-3 font-mono text-xs">
          <div class="flex flex-col gap-1.5">
            <div class="flex items-center justify-between">
              <label for="func-f" class="text-brand-text-dim uppercase text-[9px] tracking-wider">f(x) (Precision Blue)</label>
              <span class="w-2.5 h-2.5 rounded-full bg-brand-blue shadow-[0_0_6px_rgba(91,156,246,0.5)]"></span>
            </div>
            <input 
              type="text" 
              id="func-f" 
              placeholder="e.g. x^2" 
              class="w-full bg-brand-black border border-brand-border rounded px-3 py-2 text-brand-text placeholder-brand-text-dim focus:outline-none focus:border-brand-blue"
              value="x^2 - 4"
            />
          </div>

          <div class="flex flex-col gap-1.5">
            <div class="flex items-center justify-between">
              <label for="func-g" class="text-brand-text-dim uppercase text-[9px] tracking-wider">g(x) (Computational Orange)</label>
              <span class="w-2.5 h-2.5 rounded-full bg-brand-orange shadow-[0_0_6px_rgba(255,108,0,0.5)]"></span>
            </div>
            <input 
              type="text" 
              id="func-g" 
              placeholder="e.g. sin(x)" 
              class="w-full bg-brand-black border border-brand-border rounded px-3 py-2 text-brand-text placeholder-brand-text-dim focus:outline-none focus:border-brand-orange"
              value="2*sin(x)"
            />
          </div>

          <button 
            id="btn-plot"
            class="w-full h-10 rounded-lg bg-brand-orange text-brand-black font-bold hover:bg-brand-orange-hover hover:shadow-[0_0_12px_rgba(255,108,0,0.35)] active:scale-[0.99] transition-all cursor-pointer flex items-center justify-center text-sm"
          >
            Plot Functions
          </button>
        </div>

        <!-- Preset Curves Selector -->
        <div class="space-y-2 pt-2">
          <span class="text-brand-text-dim font-mono text-[9px] uppercase tracking-wider block">Quick Presets</span>
          <div class="grid grid-cols-2 gap-2 font-mono text-[10px]">
            <button class="preset-btn bg-brand-gray-light border border-brand-border text-brand-text-muted hover:text-white rounded py-1 cursor-pointer transition-colors" data-f="x^2" data-g="2*x">Parabola / Line</button>
            <button class="preset-btn bg-brand-gray-light border border-brand-border text-brand-text-muted hover:text-white rounded py-1 cursor-pointer transition-colors" data-f="x^3 - 3*x" data-g="x">Cubic Curves</button>
            <button class="preset-btn bg-brand-gray-light border border-brand-border text-brand-text-muted hover:text-white rounded py-1 cursor-pointer transition-colors" data-f="sin(x)" data-g="cos(x)">Trig Waves</button>
            <button class="preset-btn bg-brand-gray-light border border-brand-border text-brand-text-muted hover:text-white rounded py-1 cursor-pointer transition-colors" data-f="exp(-0.2*x)*sin(2*x)" data-g="exp(-0.2*x)">Dampened Osc</button>
          </div>
        </div>
      </div>

      <!-- Right Graph Area & Canvas -->
      <div class="lg:col-span-3 space-y-4">
        <!-- Interactive Graph Pane -->
        <div class="border border-brand-border bg-brand-gray-dark/40 rounded-xl p-4 sm:p-6 shadow-xl backdrop-blur-sm relative flex flex-col gap-3">
          
          <!-- Precision HUD Toolbar -->
          <div class="flex flex-wrap items-center justify-between gap-2 p-2 bg-brand-black/60 border border-brand-border/60 rounded-lg text-xs font-mono">
            <div class="flex items-center gap-1.5 sm:gap-2">
              <span class="text-brand-text-dim text-[10px] hidden sm:inline uppercase tracking-wider">NAV:</span>
              <button 
                id="btn-zoom-in" 
                type="button" 
                aria-label="Zoom in" 
                title="Zoom In (or scroll wheel)"
                class="h-7 px-2.5 rounded bg-brand-gray-light/60 border border-brand-border text-brand-text hover:text-white hover:bg-brand-border/60 active:scale-[0.97] transition-all cursor-pointer flex items-center gap-1 text-[11px] font-bold"
              >
                <span>+</span><span class="hidden md:inline">Zoom</span>
              </button>
              <button 
                id="btn-zoom-out" 
                type="button" 
                aria-label="Zoom out" 
                title="Zoom Out (or scroll wheel)"
                class="h-7 px-2.5 rounded bg-brand-gray-light/60 border border-brand-border text-brand-text hover:text-white hover:bg-brand-border/60 active:scale-[0.97] transition-all cursor-pointer flex items-center gap-1 text-[11px] font-bold"
              >
                <span>−</span><span class="hidden md:inline">Zoom</span>
              </button>
              <button 
                id="btn-reset-view" 
                type="button" 
                aria-label="Reset view bounds" 
                title="Reset view to default [-10, 10]"
                class="h-7 px-2.5 rounded bg-brand-gray-light/60 border border-brand-border text-brand-text-muted hover:text-white hover:bg-brand-border/60 active:scale-[0.97] transition-all cursor-pointer flex items-center gap-1 text-[11px]"
              >
                <span>⟲</span><span>Reset</span>
              </button>
              <button 
                id="btn-toggle-tangent" 
                type="button" 
                aria-label="Toggle live tangent tracer" 
                title="Toggle instantaneous derivative tangent tracer"
                class="h-7 px-2.5 rounded bg-brand-gray-light/60 border border-brand-border text-brand-text-muted hover:text-white hover:bg-brand-border/60 active:scale-[0.97] transition-all cursor-pointer flex items-center gap-1.5 text-[11px]"
              >
                <span class="w-1.5 h-1.5 rounded-full bg-neutral-600 transition-colors" id="tangent-indicator-dot"></span>
                <span>dy/dx Tangent</span>
              </button>
            </div>

            <div class="flex items-center gap-2 sm:gap-3">
              <span id="bounds-readout" class="text-[10px] text-brand-text-dim hidden md:inline font-mono tracking-tight">
                X: [-10.0, 10.0]  Y: [-6.0, 6.0]
              </span>
              <button 
                id="btn-export-png" 
                type="button" 
                aria-label="Export graph as high-resolution PNG" 
                title="Export high-resolution PNG snapshot"
                class="h-7 px-3 rounded bg-brand-orange/15 border border-brand-orange/40 text-brand-orange hover:bg-brand-orange hover:text-brand-black active:scale-[0.97] transition-all cursor-pointer flex items-center gap-1.5 text-[11px] font-bold shadow-sm"
              >
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
                <span id="export-btn-label">Export PNG</span>
              </button>
            </div>
          </div>
          
          <div class="relative">
            <!-- Canvas Plotter -->
            <canvas 
              id="graph-canvas" 
              width="1000" 
              height="600" 
              class="w-full h-[450px] sm:h-[500px] bg-brand-black border border-neutral-800 rounded-lg cursor-crosshair select-none touch-none"
            ></canvas>

            <!-- Floating Mouse Coordinate / Math Readout overlay -->
            <div 
              id="coord-overlay" 
              class="absolute hidden bg-brand-black/95 border border-brand-border rounded px-3 py-2 text-[10px] font-mono text-brand-text shadow-2xl backdrop-blur pointer-events-none space-y-1 z-10"
            >
              <!-- Populated dynamically by mousemove -->
            </div>
          </div>

          <!-- Micro-Analytic Math Readouts -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 font-mono text-[11px] border-t border-brand-border/40 pt-4 bg-brand-black/20 p-4 rounded-lg border border-brand-border/60">
            <!-- f(x) Analytics -->
            <div class="space-y-1.5">
              <div class="flex items-center gap-1.5 text-brand-blue font-bold border-b border-brand-border/20 pb-1 uppercase tracking-wider">
                <span class="w-1.5 h-1.5 rounded-full bg-brand-blue"></span>
                f(x) Function Analytics
              </div>
              <div class="grid grid-cols-3 gap-2">
                <span class="text-brand-text-dim text-[10px]">Y-INTERCEPT:</span>
                <span id="f-y-intercept" class="col-span-2 text-brand-text font-bold text-right">-4</span>
              </div>
              <div class="grid grid-cols-3 gap-2">
                <span class="text-brand-text-dim text-[10px]">X-INTERCEPTS:</span>
                <span id="f-x-intercepts" class="col-span-2 text-brand-blue-neon font-bold text-right">-2.0, 2.0</span>
              </div>
              <div class="grid grid-cols-3 gap-2">
                <span class="text-brand-text-dim text-[10px]">EXTREMA:</span>
                <span id="f-extrema" class="col-span-2 text-brand-blue font-bold text-right">(0.0, -4.0) Min</span>
              </div>
            </div>

            <!-- g(x) Analytics -->
            <div class="space-y-1.5">
              <div class="flex items-center gap-1.5 text-brand-orange font-bold border-b border-brand-border/20 pb-1 uppercase tracking-wider">
                <span class="w-1.5 h-1.5 rounded-full bg-brand-orange"></span>
                g(x) Function Analytics
              </div>
              <div class="grid grid-cols-3 gap-2">
                <span class="text-brand-text-dim text-[10px]">Y-INTERCEPT:</span>
                <span id="g-y-intercept" class="col-span-2 text-brand-text font-bold text-right">0</span>
              </div>
              <div class="grid grid-cols-3 gap-2">
                <span class="text-brand-text-dim text-[10px]">X-INTERCEPTS:</span>
                <span id="g-x-intercepts" class="col-span-2 text-brand-orange font-bold text-right">-3.14, 0.0, 3.14</span>
              </div>
              <div class="grid grid-cols-3 gap-2">
                <span class="text-brand-text-dim text-[10px]">EXTREMA:</span>
                <span id="g-extrema" class="col-span-2 text-brand-orange font-bold text-right">(-1.57, -2.0) Min, (1.57, 2.0) Max</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Localized Technical Handbook -->
    <HandbookSection handbook={handbook} lang={lang} />

    <!-- Comprehensive Educational Pedagogy & Architecture -->
    <CalculatorPedagogy {...pedagogy} lang={lang} />

    <!-- FAQ Accordion Section & JSON-LD -->
    <FaqSection faqs={faqs} heading={faqHeadingMap[lang]} />
  </div>

  <script>
    // --- Expression Parser for variable x ---
    function tokenize(str: string) {
      const regex = /\d+(\.\d*)?(e[+-]?\d+)?|[a-zA-Z_]+|\+|\-|\*|\/|\^|\%|\(|\)|\!|\,/g;
      return str.match(regex) || [];
    }

    function parse(tokens: string[]) {
      const outputQueue: any[] = [];
      const operatorStack: string[] = [];
      const operators: Record<string, { precedence: number; associativity: 'Left' | 'Right' }> = {
        '+': { precedence: 2, associativity: 'Left' },
        '-': { precedence: 2, associativity: 'Left' },
        '*': { precedence: 3, associativity: 'Left' },
        '/': { precedence: 3, associativity: 'Left' },
        '^': { precedence: 4, associativity: 'Right' },
        'u-': { precedence: 5, associativity: 'Right' }
      };
      const functions = new Set(['sin', 'cos', 'tan', 'asin', 'acos', 'atan', 'log', 'ln', 'sqrt', 'exp']);

      for (let i = 0; i < tokens.length; i++) {
        const token = tokens[i];

        if (token === '-' || token === '+') {
          const prev = tokens[i - 1];
          const isUnary = i === 0 || prev === '(' || prev === ',' || ['+', '-', '*', '/', '^'].includes(prev);
          if (isUnary) {
            if (token === '-') {
              while (operatorStack.length > 0) {
                const top = operatorStack[operatorStack.length - 1];
                if (operators[top] && operators[top].precedence >= 5) {
                  outputQueue.push(operatorStack.pop());
                } else break;
              }
              operatorStack.push('u-');
            }
            continue;
          }
        }

        if (!isNaN(parseFloat(token)) && isFinite(token as any)) {
          outputQueue.push({ type: 'number', value: parseFloat(token) });
        } else if (token === 'x' || token === 'X') {
          outputQueue.push({ type: 'variable', name: 'x' });
        } else if (token === 'pi' || token === 'π') {
          outputQueue.push({ type: 'number', value: Math.PI });
        } else if (token === 'e') {
          outputQueue.push({ type: 'number', value: Math.E });
        } else if (functions.has(token)) {
          operatorStack.push(token);
        } else if (operators[token]) {
          const op = operators[token];
          while (operatorStack.length > 0) {
            const top = operatorStack[operatorStack.length - 1];
            if (functions.has(top)) {
              outputQueue.push(operatorStack.pop());
            } else if (operators[top] && (operators[top].precedence > op.precedence || (operators[top].precedence === op.precedence && op.associativity === 'Left'))) {
              outputQueue.push(operatorStack.pop());
            } else break;
          }
          operatorStack.push(token);
        } else if (token === '(') {
          operatorStack.push(token);
        } else if (token === ')') {
          let found = false;
          while (operatorStack.length > 0) {
            const top = operatorStack.pop();
            if (top === '(') { found = true; break; }
            outputQueue.push(top);
          }
          if (!found) throw new Error('Parentheses mismatch');
        } else if (token === ',') {
          let found = false;
          while (operatorStack.length > 0) {
            const top = operatorStack[operatorStack.length - 1];
            if (top === '(') { found = true; break; }
            outputQueue.push(operatorStack.pop());
          }
          if (!found) throw new Error('Comma misplaced');
        }
      }

      while (operatorStack.length > 0) {
        const top = operatorStack.pop();
        if (top === '(' || top === ')') throw new Error('Parentheses mismatch');
        outputQueue.push(top);
      }

      return outputQueue;
    }

    function evaluateRPN(rpn: any[], xVal: number) {
      const stack: number[] = [];

      for (let i = 0; i < rpn.length; i++) {
        const token = rpn[i];
        if (typeof token === 'object' && token.type === 'number') {
          stack.push(token.value);
        } else if (typeof token === 'object' && token.type === 'variable' && token.name === 'x') {
          stack.push(xVal);
        } else if (token === 'u-') {
          const v = stack.pop()!;
          stack.push(-v);
        } else if (typeof token === 'string') {
          const functions: Record<string, (v: number) => number> = {
            'sin': Math.sin, 'cos': Math.cos, 'tan': Math.tan,
            'asin': Math.asin, 'acos': Math.acos, 'atan': Math.atan,
            'log': Math.log10, 'ln': Math.log, 'sqrt': Math.sqrt, 'exp': Math.exp
          };

          if (functions[token]) {
            const val = stack.pop()!;
            stack.push(functions[token](val));
          } else {
            const b = stack.pop()!;
            const a = stack.pop()!;
            switch (token) {
              case '+': stack.push(a + b); break;
              case '-': stack.push(a - b); break;
              case '*': stack.push(a * b); break;
              case '/': stack.push(a / b); break;
              case '^': stack.push(Math.pow(a, b)); break;
            }
          }
        }
      }
      return stack[0];
    }

    function cleanVal(v: number) {
      if (typeof v !== 'number' || isNaN(v) || !isFinite(v)) return v;
      return Number(v.toFixed(3));
    }

    // --- Interactive Graphing Dashboard logic ---
    const canvas = document.getElementById('graph-canvas') as HTMLCanvasElement;
    const ctx = canvas.getContext('2d')!;
    
    const coordOverlay = document.getElementById('coord-overlay')!;
    
    const inputF = document.getElementById('func-f') as HTMLInputElement;
    const inputG = document.getElementById('func-g') as HTMLInputElement;
    const btnPlot = document.getElementById('btn-plot')!;

    // Math boundaries (mutable for dynamic pan & zoom)
    const DEFAULT_BOUNDS = { xMin: -10, xMax: 10, yMin: -6, yMax: 6 };
    let xMin = DEFAULT_BOUNDS.xMin, xMax = DEFAULT_BOUNDS.xMax;
    let yMin = DEFAULT_BOUNDS.yMin, yMax = DEFAULT_BOUNDS.yMax;
    let tangentEnabled = false;

    let isPanning = false;
    let panStartX = 0;
    let panStartY = 0;
    let panInitialBounds = { xMin: DEFAULT_BOUNDS.xMin, xMax: DEFAULT_BOUNDS.xMax, yMin: DEFAULT_BOUNDS.yMin, yMax: DEFAULT_BOUNDS.yMax };

    let rpnF: any[] | null = null;
    let rpnG: any[] | null = null;

    const boundsReadout = document.getElementById('bounds-readout');
    function updateBoundsReadout() {
      if (boundsReadout) {
        boundsReadout.textContent = `X: [${xMin.toFixed(1)}, ${xMax.toFixed(1)}]  Y: [${yMin.toFixed(1)}, ${yMax.toFixed(1)}]`;
      }
    }

    function toPixelX(x: number) {
      return ((x - xMin) / (xMax - xMin)) * canvas.width;
    }

    function toPixelY(y: number) {
      return (1 - (y - yMin) / (yMax - yMin)) * canvas.height;
    }

    function toMathX(px: number) {
      return xMin + (px / canvas.width) * (xMax - xMin);
    }

    function toMathY(py: number) {
      return yMax - (py / canvas.height) * (yMax - yMin);
    }

    // Dynamic step sizing (TradingView coordinate precision)
    function getNiceStep(range: number, targetTicks = 10) {
      const rawStep = Math.max(range / targetTicks, 1e-6);
      const mag = Math.pow(10, Math.floor(Math.log10(rawStep)));
      const norm = rawStep / mag;
      let step = mag;
      if (norm > 5) step = 10 * mag;
      else if (norm > 2) step = 5 * mag;
      else if (norm > 1) step = 2 * mag;
      return step;
    }

    function drawGrid() {
      ctx.clearRect(0, 0, canvas.width, canvas.height);

      // Light/Dark Theme colors check (TradingView coordinate precision)
      const isLight = document.documentElement.classList.contains('light');
      const gridColor = isLight ? '#dee2e6' : '#141720';
      const axisColor = isLight ? '#adb5bd' : '#242938';
      const textColor = isLight ? '#495057' : '#8890a0';

      ctx.lineWidth = 1;
      ctx.strokeStyle = gridColor;
      ctx.fillStyle = textColor;
      ctx.font = '10px monospace';

      // Dynamic vertical lines & x-axis ticks
      const xRange = xMax - xMin;
      const xStep = getNiceStep(xRange, 10);
      const startX = Math.ceil(xMin / xStep) * xStep;

      for (let x = startX; x <= xMax + 1e-9; x += xStep) {
        const roundedX = Number(x.toFixed(6));
        const px = toPixelX(roundedX);
        ctx.beginPath();
        ctx.moveTo(px, 0);
        ctx.lineTo(px, canvas.height);
        ctx.stroke();

        if (Math.abs(roundedX) > 1e-6) {
          const py = Math.min(Math.max(toPixelY(0), 16), canvas.height - 8);
          const label = Math.abs(roundedX) >= 1000 || (Math.abs(roundedX) < 0.01 && Math.abs(roundedX) > 0)
            ? roundedX.toExponential(1)
            : String(Number(roundedX.toPrecision(4)));
          ctx.fillText(label, px - 6, py + 12);
        }
      }

      // Dynamic horizontal lines & y-axis ticks
      const yRange = yMax - yMin;
      const yStep = getNiceStep(yRange, 8);
      const startY = Math.ceil(yMin / yStep) * yStep;

      for (let y = startY; y <= yMax + 1e-9; y += yStep) {
        const roundedY = Number(y.toFixed(6));
        const py = toPixelY(roundedY);
        ctx.beginPath();
        ctx.moveTo(0, py);
        ctx.lineTo(canvas.width, py);
        ctx.stroke();

        if (Math.abs(roundedY) > 1e-6) {
          const px = Math.min(Math.max(toPixelX(0), 6), canvas.width - 44);
          const label = Math.abs(roundedY) >= 1000 || (Math.abs(roundedY) < 0.01 && Math.abs(roundedY) > 0)
            ? roundedY.toExponential(1)
            : String(Number(roundedY.toPrecision(4)));
          ctx.fillText(label, px + 6, py + 3);
        }
      }

      // Central axes lines
      ctx.lineWidth = 1.5;
      ctx.strokeStyle = axisColor;

      // X-Axis
      if (yMin <= 0 && yMax >= 0) {
        const py0 = toPixelY(0);
        ctx.beginPath();
        ctx.moveTo(0, py0);
        ctx.lineTo(canvas.width, py0);
        ctx.stroke();
      }

      // Y-Axis
      if (xMin <= 0 && xMax >= 0) {
        const px0 = toPixelX(0);
        ctx.beginPath();
        ctx.moveTo(px0, 0);
        ctx.lineTo(px0, canvas.height);
        ctx.stroke();
      }
    }

    function plotCurve(rpn: any[], color: string) {
      ctx.beginPath();
      ctx.lineWidth = 2.5;
      ctx.strokeStyle = color;

      let first = true;
      const step = 2; // pixel step

      for (let px = 0; px <= canvas.width; px += step) {
        const x = toMathX(px);
        try {
          const y = evaluateRPN(rpn, x);
          if (isNaN(y) || !isFinite(y)) {
            first = true;
            continue;
          }
          const py = toPixelY(y);

          if (first) {
            ctx.moveTo(px, py);
            first = false;
          } else {
            ctx.lineTo(px, py);
          }
        } catch (err) {
          first = true;
        }
      }
      ctx.stroke();
    }

    function renderScene() {
      drawGrid();
      if (rpnF) plotCurve(rpnF, '#5B9CF6'); // TradingView Precision Blue
      if (rpnG) plotCurve(rpnG, '#FF6C00'); // Wolfram Computational Orange
    }

    // Parse and plot formula values
    function compileFunctions() {
      rpnF = null;
      rpnG = null;
      
      try {
        if (inputF.value.trim()) rpnF = parse(tokenize(inputF.value));
      } catch (err) {}

      try {
        if (inputG.value.trim()) rpnG = parse(tokenize(inputG.value));
      } catch (err) {}

      renderScene();
      calculateAnalytics();
    }

    // Sweeping algorithms to calculate mathematical readouts
    function calculateAnalytics() {
      // f(x)
      calculateSingleAnalytics(rpnF, 'f');
      // g(x)
      calculateSingleAnalytics(rpnG, 'g');
    }

    function calculateSingleAnalytics(rpn: any[] | null, prefix: string) {
      const yInterceptEl = document.getElementById(`${prefix}-y-intercept`)!;
      const xInterceptsEl = document.getElementById(`${prefix}-x-intercepts`)!;
      const extremaEl = document.getElementById(`${prefix}-extrema`)!;

      if (!rpn) {
        yInterceptEl.textContent = '—';
        xInterceptsEl.textContent = '—';
        extremaEl.textContent = '—';
        return;
      }

      try {
        // Y-intercept
        const y0 = evaluateRPN(rpn, 0);
        yInterceptEl.textContent = isNaN(y0) || !isFinite(y0) ? 'Undefined' : String(cleanVal(y0));

        // X-intercepts (Sweep + Bisection)
        const roots: number[] = [];
        const xSpan = Math.abs(xMax - xMin);
        const sweepStep = Math.max(xSpan / 400, 0.01);
        let prevVal = evaluateRPN(rpn, xMin);
        
        for (let x = xMin + sweepStep; x <= xMax; x += sweepStep) {
          const val = evaluateRPN(rpn, x);
          if (isNaN(val) || !isFinite(val) || isNaN(prevVal) || !isFinite(prevVal)) {
            prevVal = val;
            continue;
          }

          if ((prevVal < 0 && val > 0) || (prevVal > 0 && val < 0)) {
            // Root bracketed between x - sweepStep and x. Perform bisection
            let left = x - sweepStep;
            let right = x;
            let mid = left;
            for (let iter = 0; iter < 10; iter++) {
              mid = (left + right) / 2;
              const midVal = evaluateRPN(rpn, mid);
              if (Math.abs(midVal) < 1.e-6) break;
              if (midVal * evaluateRPN(rpn, left) < 0) right = mid;
              else left = mid;
            }
            roots.push(cleanVal(mid));
          } else if (Math.abs(val) < 1.e-5) {
            roots.push(cleanVal(x));
          }
          prevVal = val;
        }
        
        // Remove duplicate roots
        const uniqueRoots = [...new Set(roots)].filter(r => r >= xMin && r <= xMax).sort((a,b)=>a-b);
        xInterceptsEl.textContent = uniqueRoots.length > 0 ? uniqueRoots.join(', ') : 'None inside grid';

        // Extrema detection
        const extrema: string[] = [];
        const h = Math.max(xSpan * 0.0005, 0.001);
        const getSlope = (coordX: number) => {
          const y1 = evaluateRPN(rpn, coordX + h);
          const y0 = evaluateRPN(rpn, coordX - h);
          return (y1 - y0) / (2 * h);
        };

        const extremaStep = Math.max(xSpan / 300, 0.02);
        let prevSlope = getSlope(xMin + extremaStep);
        for (let x = xMin + 2 * extremaStep; x < xMax - extremaStep; x += extremaStep) {
          const slope = getSlope(x);
          if (isNaN(slope) || isNaN(prevSlope)) {
            prevSlope = slope;
            continue;
          }

          if (prevSlope < 0 && slope > 0) {
            // valley (Min)
            const y = evaluateRPN(rpn, x);
            extrema.push(`(${cleanVal(x)}, ${cleanVal(y)}) Min`);
          } else if (prevSlope > 0 && slope < 0) {
            // peak (Max)
            const y = evaluateRPN(rpn, x);
            extrema.push(`(${cleanVal(x)}, ${cleanVal(y)}) Max`);
          }
          prevSlope = slope;
        }

        extremaEl.textContent = extrema.length > 0 ? extrema.slice(0, 2).join(', ') : 'None inside grid';

      } catch (err) {
        yInterceptEl.textContent = 'Error';
        xInterceptsEl.textContent = 'Error';
        extremaEl.textContent = 'Error';
      }
    }

    // Dynamic Tangent Line tracer helper
    function drawTangent(rpn: any[], mathX: number, color: string) {
      try {
        const h = Math.max((xMax - xMin) * 0.0001, 0.0001);
        const y0 = evaluateRPN(rpn, mathX);
        const yPlus = evaluateRPN(rpn, mathX + h);
        const yMinus = evaluateRPN(rpn, mathX - h);
        if (isNaN(y0) || !isFinite(y0) || isNaN(yPlus) || isNaN(yMinus)) return null;

        const slope = (yPlus - yMinus) / (2 * h);
        if (isNaN(slope) || !isFinite(slope)) return null;

        // Tangent line: y - y0 = slope * (x - mathX) => y = y0 + slope * (x - mathX)
        const yStart = y0 + slope * (xMin - mathX);
        const yEnd = y0 + slope * (xMax - mathX);

        ctx.save();
        ctx.strokeStyle = color;
        ctx.lineWidth = 1.8;
        ctx.setLineDash([6, 4]);

        ctx.beginPath();
        ctx.moveTo(toPixelX(xMin), toPixelY(yStart));
        ctx.lineTo(toPixelX(xMax), toPixelY(yEnd));
        ctx.stroke();

        // Contact point marker
        ctx.fillStyle = color;
        ctx.beginPath();
        ctx.arc(toPixelX(mathX), toPixelY(y0), 4.5, 0, Math.PI * 2);
        ctx.fill();

        ctx.restore();

        const intercept = y0 - slope * mathX;
        return { y0, slope, intercept };
      } catch (err) {
        return null;
      }
    }

    // Mouse interactive coordinates tracking
    canvas.addEventListener('mousemove', (e) => {
      if (isPanning) return;

      const rect = canvas.getBoundingClientRect();
      const mouseX = e.clientX - rect.left;
      const mouseY = e.clientY - rect.top;

      // Scaling factor for CSS width/height mismatch
      const scaleX = canvas.width / rect.width;
      const scaleY = canvas.height / rect.height;

      const px = mouseX * scaleX;
      const py = mouseY * scaleY;

      const mathX = toMathX(px);
      const mathY = toMathY(py);

      let overlayHtml = `<div class="font-bold text-brand-blue-neon uppercase text-[9px] border-b border-brand-border/30 pb-1 mb-1">Grid Cursor</div>`;
      overlayHtml += `<div>X: ${mathX.toFixed(3)}</div>`;
      overlayHtml += `<div>Y: ${mathY.toFixed(3)}</div>`;

      // Re-draw base scene
      renderScene();

      // Tangent or instantaneous function readout
      if (tangentEnabled) {
        if (rpnF) {
          const tInfoF = drawTangent(rpnF, mathX, '#A78BFA'); // Raycast Purple
          if (tInfoF) {
            overlayHtml += `<div class="mt-1.5 pt-1.5 border-t border-brand-border/20 text-[#A78BFA] font-bold text-[10px]">f'(x) = ${tInfoF.slope.toFixed(3)}</div>`;
            overlayHtml += `<div class="text-[9px] text-[#A78BFA]/90">y = ${tInfoF.slope.toFixed(2)}x ${tInfoF.intercept >= 0 ? '+' : '-'} ${Math.abs(tInfoF.intercept).toFixed(2)}</div>`;
          }
        }
        if (rpnG) {
          const tInfoG = drawTangent(rpnG, mathX, '#FF9933'); // Warm Amber-Orange
          if (tInfoG) {
            overlayHtml += `<div class="mt-1 pt-1 border-t border-brand-border/20 text-brand-orange font-bold text-[10px]">g'(x) = ${tInfoG.slope.toFixed(3)}</div>`;
            overlayHtml += `<div class="text-[9px] text-brand-orange/90">y = ${tInfoG.slope.toFixed(2)}x ${tInfoG.intercept >= 0 ? '+' : '-'} ${Math.abs(tInfoG.intercept).toFixed(2)}</div>`;
          }
        }
      } else {
        const h = Math.max((xMax - xMin) * 0.0001, 0.001);
        if (rpnF) {
          try {
            const yF = evaluateRPN(rpnF, mathX);
            const yF_plus = evaluateRPN(rpnF, mathX + h);
            const yF_minus = evaluateRPN(rpnF, mathX - h);
            const slopeF = (yF_plus - yF_minus) / (2 * h);
            
            if (!isNaN(yF) && isFinite(yF)) {
              overlayHtml += `<div class="mt-1.5 pt-1.5 border-t border-brand-border/20 text-brand-blue font-bold">f(x): ${yF.toFixed(3)}</div>`;
              overlayHtml += `<div class="text-[9px] text-brand-text-dim">Slope: ${slopeF.toFixed(3)}</div>`;
            }
          } catch(err){}
        }

        if (rpnG) {
          try {
            const yG = evaluateRPN(rpnG, mathX);
            const yG_plus = evaluateRPN(rpnG, mathX + h);
            const yG_minus = evaluateRPN(rpnG, mathX - h);
            const slopeG = (yG_plus - yG_minus) / (2 * h);

            if (!isNaN(yG) && isFinite(yG)) {
              overlayHtml += `<div class="mt-1 pt-1 border-t border-brand-border/20 text-brand-orange font-bold">g(x): ${yG.toFixed(3)}</div>`;
              overlayHtml += `<div class="text-[9px] text-brand-text-dim">Slope: ${slopeG.toFixed(3)}</div>`;
            }
          } catch(err){}
        }
      }

      coordOverlay.innerHTML = overlayHtml;
      
      // Position floating overlay near mouse, keep inside canvas bounds
      const overlayWidth = 160;
      const overlayLeft = (mouseX + 15 + overlayWidth > rect.width) ? (mouseX - overlayWidth - 10) : (mouseX + 15);
      coordOverlay.style.left = `${Math.max(overlayLeft, 10)}px`;
      coordOverlay.style.top = `${mouseY + 15}px`;
      coordOverlay.classList.remove('hidden');

      // Guide lines
      ctx.lineWidth = 1;
      ctx.setLineDash([4, 4]);
      ctx.strokeStyle = '#3e3e3e';
      
      // vertical crosshair
      ctx.beginPath();
      ctx.moveTo(px, 0);
      ctx.lineTo(px, canvas.height);
      ctx.stroke();

      // horizontal crosshair
      ctx.beginPath();
      ctx.moveTo(0, py);
      ctx.lineTo(canvas.width, py);
      ctx.stroke();

      ctx.setLineDash([]); // clear dash
    });

    canvas.addEventListener('mouseleave', () => {
      coordOverlay.classList.add('hidden');
      renderScene();
    });

    // Zoom logic
    function zoom(factor: number, centerX?: number, centerY?: number) {
      const cx = centerX !== undefined ? centerX : (xMin + xMax) / 2;
      const cy = centerY !== undefined ? centerY : (yMin + yMax) / 2;

      const newSpanX = (xMax - xMin) * factor;
      const newSpanY = (yMax - yMin) * factor;

      if (newSpanX < 1e-4 || newSpanX > 1e6) return;

      const ratioX = (cx - xMin) / (xMax - xMin);
      const ratioY = (cy - yMin) / (yMax - yMin);

      xMin = cx - ratioX * newSpanX;
      xMax = xMin + newSpanX;
      yMin = cy - ratioY * newSpanY;
      yMax = yMin + newSpanY;

      updateBoundsReadout();
      renderScene();
      calculateAnalytics();
    }

    // Scroll wheel zoom
    canvas.addEventListener('wheel', (e) => {
      e.preventDefault();
      const rect = canvas.getBoundingClientRect();
      const mouseX = e.clientX - rect.left;
      const mouseY = e.clientY - rect.top;
      const scaleX = canvas.width / rect.width;
      const scaleY = canvas.height / rect.height;
      const mathX = toMathX(mouseX * scaleX);
      const mathY = toMathY(mouseY * scaleY);

      const factor = e.deltaY < 0 ? 0.88 : 1.14;
      zoom(factor, mathX, mathY);
    }, { passive: false });

    // Drag-to-Pan (Mouse)
    canvas.addEventListener('mousedown', (e) => {
      if (e.button !== 0) return;
      isPanning = true;
      panStartX = e.clientX;
      panStartY = e.clientY;
      panInitialBounds = { xMin, xMax, yMin, yMax };
      canvas.style.cursor = 'grabbing';
      coordOverlay.classList.add('hidden');
    });

    window.addEventListener('mousemove', (e) => {
      if (!isPanning) return;
      const dx = e.clientX - panStartX;
      const dy = e.clientY - panStartY;
      const rect = canvas.getBoundingClientRect();

      const spanX = panInitialBounds.xMax - panInitialBounds.xMin;
      const spanY = panInitialBounds.yMax - panInitialBounds.yMin;

      const mathDx = (dx / rect.width) * spanX;
      const mathDy = (dy / rect.height) * spanY;

      xMin = panInitialBounds.xMin - mathDx;
      xMax = panInitialBounds.xMax - mathDx;
      yMin = panInitialBounds.yMin + mathDy;
      yMax = panInitialBounds.yMax + mathDy;

      updateBoundsReadout();
      renderScene();
    });

    window.addEventListener('mouseup', () => {
      if (isPanning) {
        isPanning = false;
        canvas.style.cursor = 'crosshair';
        calculateAnalytics();
      }
    });

    // Touch pan (Mobile)
    let touchStartX = 0;
    let touchStartY = 0;
    let isTouching = false;

    canvas.addEventListener('touchstart', (e) => {
      if (e.touches.length === 1) {
        isTouching = true;
        touchStartX = e.touches[0].clientX;
        touchStartY = e.touches[0].clientY;
        panInitialBounds = { xMin, xMax, yMin, yMax };
      }
    }, { passive: true });

    canvas.addEventListener('touchmove', (e) => {
      if (!isTouching || e.touches.length !== 1) return;
      const dx = e.touches[0].clientX - touchStartX;
      const dy = e.touches[0].clientY - touchStartY;
      const rect = canvas.getBoundingClientRect();

      const spanX = panInitialBounds.xMax - panInitialBounds.xMin;
      const spanY = panInitialBounds.yMax - panInitialBounds.yMin;

      xMin = panInitialBounds.xMin - (dx / rect.width) * spanX;
      xMax = panInitialBounds.xMax - (dx / rect.width) * spanX;
      yMin = panInitialBounds.yMin + (dy / rect.height) * spanY;
      yMax = panInitialBounds.yMax + (dy / rect.height) * spanY;

      updateBoundsReadout();
      renderScene();
    }, { passive: true });

    canvas.addEventListener('touchend', () => {
      if (isTouching) {
        isTouching = false;
        calculateAnalytics();
      }
    });

    // Navigation & Toolbar Button Event Listeners
    document.getElementById('btn-zoom-in')?.addEventListener('click', () => zoom(0.8));
    document.getElementById('btn-zoom-out')?.addEventListener('click', () => zoom(1.25));
    document.getElementById('btn-reset-view')?.addEventListener('click', () => {
      xMin = DEFAULT_BOUNDS.xMin;
      xMax = DEFAULT_BOUNDS.xMax;
      yMin = DEFAULT_BOUNDS.yMin;
      yMax = DEFAULT_BOUNDS.yMax;
      updateBoundsReadout();
      renderScene();
      calculateAnalytics();
    });

    // Live Tangent Slope Tracer Toggle
    const btnTangent = document.getElementById('btn-toggle-tangent');
    const tangentIndicatorDot = document.getElementById('tangent-indicator-dot');
    btnTangent?.addEventListener('click', () => {
      tangentEnabled = !tangentEnabled;
      if (tangentEnabled) {
        btnTangent.classList.add('bg-brand-orange/20', 'text-brand-orange', 'border-brand-orange/50');
        btnTangent.classList.remove('bg-brand-gray-light/60', 'text-brand-text-muted', 'border-brand-border');
        tangentIndicatorDot?.classList.remove('bg-neutral-600');
        tangentIndicatorDot?.classList.add('bg-brand-orange', 'shadow-[0_0_6px_rgba(255,108,0,0.8)]');
      } else {
        btnTangent.classList.remove('bg-brand-orange/20', 'text-brand-orange', 'border-brand-orange/50');
        btnTangent.classList.add('bg-brand-gray-light/60', 'text-brand-text-muted', 'border-brand-border');
        tangentIndicatorDot?.classList.remove('bg-brand-orange', 'shadow-[0_0_6px_rgba(255,108,0,0.8)]');
        tangentIndicatorDot?.classList.add('bg-neutral-600');
        renderScene();
      }
    });

    // High-Resolution PNG Export
    const btnExport = document.getElementById('btn-export-png');
    const exportBtnLabel = document.getElementById('export-btn-label');
    btnExport?.addEventListener('click', () => {
      renderScene();

      // Draw subtle watermark branding
      ctx.save();
      ctx.fillStyle = 'rgba(255, 255, 255, 0.45)';
      ctx.font = '12px monospace';
      ctx.textAlign = 'right';
      ctx.fillText('SciCalcX.com • Precision Graph Engine', canvas.width - 16, canvas.height - 16);
      ctx.restore();

      const dataUrl = canvas.toDataURL('image/png');

      const a = document.createElement('a');
      a.href = dataUrl;
      a.download = `scicalcx-graph-${Date.now()}.png`;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);

      renderScene();

      if (exportBtnLabel) {
        const originalText = exportBtnLabel.textContent;
        exportBtnLabel.textContent = '✓ Saved!';
        setTimeout(() => {
          if (exportBtnLabel) exportBtnLabel.textContent = originalText;
        }, 1500);
      }
    });

    btnPlot.addEventListener('click', compileFunctions);

    // Dynamic presets triggers
    document.querySelectorAll('.preset-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const f = btn.getAttribute('data-f')!;
        const g = btn.getAttribute('data-g')!;
        inputF.value = f;
        inputG.value = g;
        compileFunctions();
      });
    });

    // Theme changes events listener
    window.addEventListener('theme-changed', () => {
      compileFunctions();
    });

    // Initial load
    compileFunctions();
  </script>
</Layout>
