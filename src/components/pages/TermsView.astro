---
import Layout from '../../layouts/Layout.astro';
import { useTranslations } from '../../i18n/utils';
import type { SupportedLanguage } from '../../i18n/ui';
import { getInfoContent } from '../../i18n/content/infoPages';

interface Props {
  lang?: SupportedLanguage;
}

const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);
const content = getInfoContent('terms', lang);
---

<Layout 
  title={t('meta.terms.title')} 
  description={t('meta.terms.desc')}
  lang={lang}
>
  <div class="w-full max-w-3xl mx-auto space-y-6 sm:space-y-8 font-sans">
    <!-- Page Header -->
    <div class="text-center md:text-left space-y-1.5 border-b border-brand-border/60 pb-4">
      <div class="text-[10px] font-mono uppercase tracking-widest text-brand-blue-neon">
        {content.badge}
      </div>
      <h1 class="text-3xl font-bold tracking-tight text-brand-text">
        {content.heading}<span class="text-brand-blue">.</span>
      </h1>
      <p class="text-xs text-brand-text-muted">
        {content.subheading}
      </p>
    </div>

    <!-- Terms details -->
    <div class="border border-brand-border bg-brand-gray-dark/40 rounded-xl p-6 sm:p-8 space-y-6 shadow-xl backdrop-blur-sm leading-relaxed text-sm text-brand-text-muted">
      {content.sections.map((sec) => (
        <section class="space-y-3">
          <h2 class="text-base font-semibold text-white font-mono uppercase tracking-wider">
            {sec.title}
          </h2>
          {sec.paragraphs ? (
            sec.paragraphs.map((p) => <p class="leading-relaxed">{p}</p>)
          ) : (
            <p class="leading-relaxed">{sec.body}</p>
          )}
        </section>
      ))}
    </div>
  </div>
</Layout>
