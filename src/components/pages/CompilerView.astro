---
import Layout from '../../layouts/Layout.astro';
import CompilerWorkspace from '../CompilerWorkspace.astro';
import { useTranslations } from '../../i18n/utils';
import type { SupportedLanguage } from '../../i18n/ui';
import { getFaqs } from '../../i18n/content/faq';
import { compilerContent } from '../../i18n/content/compilerContent';
import FaqSection from '../FaqSection.astro';

interface Props {
  lang?: SupportedLanguage;
}

const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);
const faqs = getFaqs('compiler', lang);
const content = compilerContent[lang] || compilerContent.en;

const faqHeadingMap: Record<SupportedLanguage, string> = {
  en: 'Frequently Asked Questions',
  es: 'Preguntas Frecuentes',
  ja: 'よくある質問（FAQ）',
  fr: 'Foire Aux Questions',
  de: 'Häufig gestellte Fragen',
  nl: 'Veelgestelde Vragen',
  pt: 'Perguntas Frequentes',
  ko: '자주 묻는 질문 (FAQ)',
  it: 'Domande Frequenti',
};
---

<Layout 
  activeTab="compiler" 
  lang={lang}
  title={t('meta.compiler.title')} 
  description={t('meta.compiler.desc')}
  keywords={t('meta.compiler.keywords')}
>
  <CompilerWorkspace lang={lang} />

  <!-- Educational Reference Guide & Sandbox Architecture -->
  <div class="w-full max-w-6xl mx-auto mt-8 border border-brand-border bg-brand-gray-dark/30 rounded-xl p-5 sm:p-6 space-y-6 shadow-xl font-sans text-xs text-brand-text-muted leading-relaxed">
    <div class="border-b border-brand-border/40 pb-3">
      <span class="text-brand-blue-neon font-mono text-[10px] uppercase tracking-wider block">{content.architectureBadge}</span>
      <h2 class="text-lg font-bold text-white tracking-tight mt-0.5">{content.architectureHeading}</h2>
      <p class="text-xs text-brand-text-muted mt-1">{content.architectureSubheading}</p>
    </div>

    <!-- Execution Architecture Transparency Box -->
    <div class="p-4 rounded-lg border border-brand-border/60 bg-brand-black/40 space-y-2 text-xs">
      <p>
        {content.architectureP1}
      </p>
      <p>
        {content.architectureP2}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="space-y-2">
        <h3 class="text-sm font-semibold text-white font-mono uppercase">{content.sandboxTitle}</h3>
        <p>
          {content.sandboxDesc}
        </p>
      </div>

      <div class="space-y-2">
        <h3 class="text-sm font-semibold text-white font-mono uppercase">{content.terminalTitle}</h3>
        <p>
          {content.terminalDesc}
        </p>
      </div>

      <div class="space-y-2">
        <h3 class="text-sm font-semibold text-white font-mono uppercase">{content.curriculumTitle}</h3>
        <p>
          {content.curriculumDesc}
        </p>
      </div>
    </div>
  </div>

  <!-- Localized FAQ Accordion & JSON-LD Schema -->
  <div class="w-full max-w-6xl mx-auto">
    <FaqSection faqs={faqs} heading={faqHeadingMap[lang]} />
  </div>
</Layout>
