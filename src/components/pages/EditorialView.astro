---
import Layout from '../../layouts/Layout.astro';
import { useTranslations, useTranslatedPath } from '../../i18n/utils';
import type { SupportedLanguage } from '../../i18n/ui';
import { getInfoContent } from '../../i18n/content/infoPages';

interface Props {
  lang?: SupportedLanguage;
}

const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
const content = getInfoContent('editorial', lang);
---

<Layout 
  title="Editorial Integrity & Standards | SciCalcX" 
  description="Discover SciCalcX's rigorous editorial standards, mathematical verification methodologies, peer checks, and error correction procedures."
  lang={lang}
>
  <div class="w-full max-w-3xl mx-auto space-y-8 font-sans">
    <!-- Page Header -->
    <div class="text-center md:text-left space-y-1.5 border-b border-brand-border/60 pb-4">
      <div class="text-[10px] font-mono uppercase tracking-widest text-brand-blue-neon">
        {content.badge}
      </div>
      <h1 class="text-3xl font-bold tracking-tight text-brand-text">
        {content.heading}<span class="text-brand-blue">.</span>
      </h1>
      <p class="text-xs text-brand-text-muted">
        {content.subheading}
      </p>
    </div>

    <!-- Editorial Sections -->
    <div class="border border-brand-border bg-brand-gray-dark/40 rounded-xl p-6 sm:p-8 space-y-8 shadow-xl backdrop-blur-sm">
      {content.sections.map((sec, idx) => (
        <section class="space-y-3 border-b border-brand-border/30 pb-6 last:border-b-0 last:pb-0">
          <h2 class="text-base font-semibold text-white font-mono uppercase tracking-wider flex items-center gap-2">
            <span class="text-brand-blue-neon font-bold text-xs">{String(idx + 1).padStart(2, '0')}.</span>
            {sec.title}
          </h2>
          <div class="space-y-3 text-sm text-brand-text-muted leading-relaxed">
            {sec.paragraphs.map((p) => (
              <p>{p}</p>
            ))}
          </div>
        </section>
      ))}
    </div>

    <!-- Feedback & Error Reporting Box -->
    <div class="border border-brand-border bg-brand-gray-dark/30 rounded-xl p-6 space-y-4">
      <h2 class="text-sm font-semibold uppercase tracking-wider text-white font-mono flex items-center gap-1.5">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span> Reporting Computational or Editorial Errors
      </h2>
      <p class="text-xs text-brand-text-muted leading-relaxed">
        If you spot a numerical discrepancy, floating-point anomaly, typographical mistake, or ambiguous mathematical definition anywhere on SciCalcX, please report it immediately. Every submission is investigated directly by our core development team.
      </p>
      <div class="flex flex-wrap items-center gap-4 pt-2 font-mono text-xs">
        <a 
          href="mailto:support@scicalcx.com?subject=Editorial%20Correction%20Report" 
          class="px-4 py-2 rounded bg-brand-blue text-white font-semibold hover:bg-brand-blue-hover transition-colors"
        >
          Submit Correction via Email &rarr;
        </a>
        <a 
          href="https://github.com/RishabhDev817/scicalcx/issues" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="px-4 py-2 rounded border border-brand-border text-brand-text-muted hover:text-white hover:border-brand-border-hover transition-colors"
        >
          Open GitHub Issue &rarr;
        </a>
      </div>
    </div>
  </div>
</Layout>
